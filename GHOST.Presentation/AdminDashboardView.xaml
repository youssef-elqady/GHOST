<UserControl x:Class="GHOST.Presentation.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiPanel}" Margin="0,0,9,0"><StackPanel><TextBlock Text="إيرادات اليوم" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding RevenueText}" Foreground="{StaticResource White}" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="الجلسات + المبيعات" Foreground="{StaticResource Dim}" FontSize="9" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource KpiPanel}" Margin="0,0,9,0"><StackPanel><TextBlock Text="مبيعات المنتجات" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding ProductSalesText}" Foreground="{StaticResource White}" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="{Binding OrdersToday, StringFormat={} {0} فاتورة}" Foreground="{StaticResource Dim}" FontSize="9" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource KpiPanel}" Margin="0,0,9,0"><StackPanel><TextBlock Text="الجلسات اليوم" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding SessionsToday}" Foreground="{StaticResource White}" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="{Binding CustomersToday, StringFormat={} {0} عميل مرتبط}" Foreground="{StaticResource Dim}" FontSize="9" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Grid.Column="3" Style="{StaticResource KpiPanel}"><StackPanel><TextBlock Text="الضغط التشغيلي" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding ActiveSessions}" Foreground="{StaticResource White}" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="{Binding RunningSessions, StringFormat={} {0} جلسة تعمل الآن}" Foreground="{StaticResource Dim}" FontSize="9" Margin="0,4,0,0"/></StackPanel></Border>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,9,0"><StackPanel>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="OWNER OVERVIEW" Style="{StaticResource Eyebrow}"/><TextBlock Text="حالة المكان الآن" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource White}"/></StackPanel><Button Grid.Column="1" Content="تحديث" Style="{StaticResource PremiumSecondaryButton}" Command="{Binding RefreshCommand}"/></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="تعمل" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="{Binding RunningSessions}" Foreground="{StaticResource Green}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="متوقفة" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="{Binding PausedSessions}" Foreground="{StaticResource Amber}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="متاحة" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="{Binding AvailableDevices}" Foreground="{StaticResource Blue}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="صيانة" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="{Binding MaintenanceDevices}" Foreground="{StaticResource Red}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="غير متصل" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="{Binding OfflineDevices}" Foreground="{StaticResource Red}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,18,0,0"><StackPanel><TextBlock Text="{Binding ShiftStatusText}" Foreground="{StaticResource White}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding ShiftStatusDetail}" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,5,0,0"/><TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource Dim}" FontSize="8" Margin="0,8,0,0"/></StackPanel></Border>
                </StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel>
                    <TextBlock Text="التنبيهات" Foreground="{StaticResource White}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="ما يستحق انتباه الإدارة" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,10"/>
                    <ItemsControl ItemsSource="{Binding Alerts}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource AmberSoft}" CornerRadius="8" Padding="9" Margin="0,0,0,7"><TextBlock Text="{Binding}" Foreground="{StaticResource Amber}" FontSize="9" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="لا توجد تنبيهات تشغيلية حاليًا" Foreground="{StaticResource Green}" FontSize="9" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Alerts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel></Border>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,9,0"><StackPanel><TextBlock Text="حجم العمل" Foreground="{StaticResource White}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="الأجهزة الأكثر استخدامًا اليوم" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,12"/><ItemsControl ItemsSource="{Binding TopDevices}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Device}" Foreground="{StaticResource Text}" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding PercentText}" Foreground="{StaticResource Gold}" FontSize="10" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="المخزون والنقدية" Foreground="{StaticResource White}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="مؤشرات سريعة للإدارة" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="منخفض المخزون" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="{Binding LowStockProducts}" Foreground="{StaticResource Amber}" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="فرق النقدية" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="{Binding CashDifferenceText}" Foreground="{StaticResource White}" FontSize="18" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Grid></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Panel}"><StackPanel><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ACTIVITY" Style="{StaticResource Eyebrow}"/><TextBlock Text="آخر التغييرات" Foreground="{StaticResource White}" FontSize="19" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Column="1" Text="آخر 10 عمليات" Foreground="{StaticResource Dim}" FontSize="9" VerticalAlignment="Center"/></Grid><ItemsControl ItemsSource="{Binding RecentActivity}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="9,5"><TextBlock Text="{Binding Action}" Foreground="{StaticResource Text}" FontSize="9"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding Details}" Foreground="{StaticResource Text}" FontSize="9" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Actor}" Foreground="{StaticResource Dim}" FontSize="8" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Red}" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>