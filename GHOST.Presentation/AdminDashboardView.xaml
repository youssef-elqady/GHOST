<UserControl x:Class="GHOST.Presentation.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="Transparent"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>

        <SolidColorBrush x:Key="Bg" Color="#141310"/>
        <SolidColorBrush x:Key="Surface" Color="#1C1B17"/>
        <SolidColorBrush x:Key="Surface2" Color="#232119"/>
        <SolidColorBrush x:Key="Surface3" Color="#2A281F"/>
        <SolidColorBrush x:Key="Border" Color="#373329"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#4A4336"/>
        <SolidColorBrush x:Key="White" Color="#F7F4EC"/>
        <SolidColorBrush x:Key="Text" Color="#E5E0D5"/>
        <SolidColorBrush x:Key="Muted" Color="#A39D90"/>
        <SolidColorBrush x:Key="Dim" Color="#706B61"/>
        <SolidColorBrush x:Key="Accent" Color="#D4AF37"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#332A15"/>
        <SolidColorBrush x:Key="Gold" Color="#D4AF37"/>
        <SolidColorBrush x:Key="GoldSoft" Color="#332A15"/>
        <SolidColorBrush x:Key="Green" Color="#43C982"/>
        <SolidColorBrush x:Key="GreenSoft" Color="#15291F"/>
        <SolidColorBrush x:Key="Blue" Color="#7EA8D8"/>
        <SolidColorBrush x:Key="BlueSoft" Color="#1C2837"/>
        <SolidColorBrush x:Key="Red" Color="#E36B6B"/>
        <SolidColorBrush x:Key="RedSoft" Color="#301B1B"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MinHeight" Value="132"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface3}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="Foreground" Value="#101317"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface3}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                    <Setter Property="Foreground" Value="{StaticResource White}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="{StaticResource BorderStrong}"
                                           BorderThickness="0"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource Bg}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="30,26,30,34">

                <!-- HEADER -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="لوحة الإدارة الرئيسية"
                                   Foreground="{StaticResource White}"
                                   FontSize="30"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="مركز التحكم التشغيلي والمالي لمكان GHOST"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="12"
                                   Margin="0,6,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                            <Border Background="{StaticResource GreenSoft}"
                                    CornerRadius="7"
                                    Padding="10,5">
                                <TextBlock Text="● النظام يعمل"
                                           Foreground="{StaticResource Green}"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding LastUpdatedText}"
                                       Foreground="{StaticResource Dim}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Border Background="{StaticResource Surface2}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="13,9"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="الفترة"
                                           Foreground="{StaticResource Dim}"
                                           FontSize="10"/>
                                <TextBlock Text="{Binding SelectedPeriodText}"
                                           Foreground="{StaticResource White}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="7,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="☰  الفلاتر"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenFilters_Click"
                                Margin="0,0,8,0"/>
                        <Button Content="↻  تحديث"
                                Style="{StaticResource PrimaryButton}"
                                Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ERROR -->
                <Border Background="{StaticResource RedSoft}"
                        BorderBrush="#513036"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="13"
                        Margin="0,0,0,18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value=" ">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource Red}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- KPI ROW -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="الإيرادات"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding RevenueText}"
                                       Foreground="{StaticResource White}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,3"/>
                            <TextBlock Text="{Binding RevenueTrendText}"
                                       Foreground="{StaticResource Green}"
                                       FontSize="9"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="مبيعات المنتجات"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding ProductSalesText}"
                                       Foreground="{StaticResource White}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,3"/>
                            <TextBlock Text="{Binding ProductTrendText}"
                                       Foreground="{StaticResource Blue}"
                                       FontSize="9"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="عدد اللعب"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding SessionsText}"
                                       Foreground="{StaticResource White}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,3"/>
                            <TextBlock Text="{Binding SessionsTrendText}"
                                       Foreground="{StaticResource Gold}"
                                       FontSize="9"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="العملاء"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding CustomersText}"
                                       Foreground="{StaticResource White}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,3"/>
                            <TextBlock Text="عملاء مرتبطون باللعب"
                                       Foreground="{StaticResource Dim}"
                                       FontSize="9"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- MAIN GRID -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FINANCIAL -->
                    <Border Grid.Column="0"
                            Style="{StaticResource Card}"
                            Padding="22">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="الأداء المالي"
                                               Foreground="{StaticResource White}"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="ملخص الفترة المحددة مقارنة بالفترة السابقة"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="10"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <Border HorizontalAlignment="Left"
                                        Background="{StaticResource AccentSoft}"
                                        CornerRadius="8"
                                        Padding="9,5">
                                    <TextBlock Text="{Binding SelectedPeriodText}"
                                               Foreground="{StaticResource Blue}"
                                               FontSize="9"/>
                                </Border>
                            </Grid>

                            <Border Background="{StaticResource Surface2}"
                                    CornerRadius="12"
                                    Padding="18"
                                    Margin="0,20,0,18">
                                <StackPanel>
                                    <TextBlock Text="إجمالي المبيعات"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="10"/>
                                    <TextBlock Text="{Binding TotalSalesText}"
                                               Foreground="{StaticResource White}"
                                               FontSize="32"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding RevenueTrendText}"
                                               Foreground="{StaticResource Green}"
                                               FontSize="9"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="إيرادات اللعب"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="10"/>
                                    <TextBlock Text="{Binding RevenueText}"
                                               Foreground="{StaticResource Green}"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{StaticResource Border}"
                                        Margin="16,0"/>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="مبيعات المنتجات"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="10"/>
                                    <TextBlock Text="{Binding ProductSalesText}"
                                               Foreground="{StaticResource Blue}"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource GoldSoft}"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,20,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="مقارنة"
                                               Foreground="{StaticResource Gold}"
                                               FontSize="10"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding RevenueTrendText}"
                                               Foreground="{StaticResource Text}"
                                               FontSize="10"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ALERTS -->
                    <Border Grid.Column="2"
                            Style="{StaticResource Card}"
                            Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="مركز التنبيهات"
                                               Foreground="{StaticResource White}"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="الأشياء التي تحتاج متابعة"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="10"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <Border HorizontalAlignment="Left"
                                        Background="{StaticResource RedSoft}"
                                        CornerRadius="10"
                                        Padding="9,5">
                                    <TextBlock Text="{Binding AlertCount}"
                                               Foreground="{StaticResource Red}"
                                               FontSize="10"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          MaxHeight="205"
                                          VerticalScrollBarVisibility="Auto"
                                          Margin="0,18,0,0">
                                <ItemsControl ItemsSource="{Binding Alerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface2}"
                                                    BorderBrush="{StaticResource Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="11"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7"
                                                                 Height="7"
                                                                 Fill="{StaticResource Gold}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0"/>
                                                        <TextBlock Text="يتطلب متابعة"
                                                                   Foreground="{StaticResource Gold}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{StaticResource Text}"
                                                               FontSize="10"
                                                               TextWrapping="Wrap"
                                                               Margin="0,7,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- LIVE STATUS -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource Card}"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="اللعب النشطة الآن"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding ActiveSessionsText}"
                                       Foreground="{StaticResource Green}"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource Card}"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="متوقفة مؤقتًا"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding PausedSessions}"
                                       Foreground="{StaticResource Gold}"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4"
                            Style="{StaticResource Card}"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="حالة الشيفت"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding ShiftStatusText}"
                                       Foreground="{StaticResource White}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding ShiftStatusDetail}"
                                       Foreground="{StaticResource Dim}"
                                       FontSize="9"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- MANAGEMENT DETAILS -->
                <Expander Style="{StaticResource SectionExpander}"
                          IsExpanded="False"
                          Margin="0,0,0,10">
                    <Expander.Header>
                        <StackPanel Margin="14,10">
                            <TextBlock Text="الخزينة والمخزون"
                                       Foreground="{StaticResource White}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="تفاصيل إدارية تظهر عند الحاجة"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Expander.Header>

                    <Border Background="{StaticResource Surface}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="فرق النقدية" Foreground="{StaticResource Muted}" FontSize="10"/>
                                <TextBlock Text="{Binding CashDifferenceText}"
                                           Foreground="{StaticResource White}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="المخزون منخفض" Foreground="{StaticResource Muted}" FontSize="10"/>
                                <TextBlock Text="{Binding LowStockText}"
                                           Foreground="{StaticResource Gold}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="منتجات تحتاج مراجعة"
                                           Foreground="{StaticResource Dim}"
                                           FontSize="9"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="فتح الشيفت" Foreground="{StaticResource Muted}" FontSize="10"/>
                                <TextBlock Text="{Binding ShiftOpenedBy}"
                                           Foreground="{StaticResource White}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding ShiftOpenedAt}"
                                           Foreground="{StaticResource Dim}"
                                           FontSize="9"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>

                <!-- ACTIVITY -->
                <Expander Style="{StaticResource SectionExpander}"
                          IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Margin="14,10">
                            <TextBlock Text="آخر العمليات"
                                       Foreground="{StaticResource White}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="سجل مختصر لما تم داخل النظام"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Expander.Header>

                    <Border Background="{StaticResource Surface}" Padding="20">
                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{StaticResource Dim}" FontSize="10"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Action}" Foreground="{StaticResource Text}" FontSize="10"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Actor}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Details}" Foreground="{StaticResource Dim}" FontSize="10" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Expander>

                <TextBlock Text="GHOST • Admin Workspace"
                           Foreground="{StaticResource Dim}"
                           FontSize="9"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,5"/>
            </StackPanel>
        </ScrollViewer>

        <!-- FILTER DRAWER -->
        <Grid x:Name="FilterOverlay"
              Visibility="Collapsed"
              Background="#AA000000"
              Panel.ZIndex="100">

            <Button Background="Transparent"
                    BorderThickness="0"
                    Click="CloseFilters_Click"/>

            <Border Width="390"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderStrong}"
                    BorderThickness="1,0,0,0">

                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="الفلاتر"
                                       Foreground="{StaticResource White}"
                                       FontSize="22"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="تحكم في نطاق البيانات المعروضة"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Content="✕"
                                Style="{StaticResource SecondaryButton}"
                                Width="40"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Click="CloseFilters_Click"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,28,0,0">
                        <TextBlock Text="الفترة الزمنية"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"
                                   Margin="0,0,0,7"/>
                        <ComboBox x:Name="PeriodComboBox"
                                  Style="{StaticResource DarkComboBox}"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="اليوم"/>
                            <ComboBoxItem Content="أمس"/>
                            <ComboBoxItem Content="هذا الأسبوع"/>
                            <ComboBoxItem Content="هذا الشهر"/>
                            <ComboBoxItem Content="الشهر السابق"/>
                            <ComboBoxItem Content="فترة مخصصة"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="{StaticResource Surface2}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="15"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="الفترة المخصصة"
                                       Foreground="{StaticResource Text}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="تستخدم عند اختيار فترة مخصصة."
                                       Foreground="{StaticResource Dim}"
                                       FontSize="10"
                                       Margin="0,4,0,13"/>

                            <TextBlock Text="من" Foreground="{StaticResource Muted}" FontSize="10"/>
                            <DatePicker x:Name="FromDatePicker" Margin="0,6,0,12"/>

                            <TextBlock Text="إلى" Foreground="{StaticResource Muted}" FontSize="10"/>
                            <DatePicker x:Name="ToDatePicker" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,20,0,20">
                        <StackPanel>
                            <TextBlock Text="كيف يعمل الفلتر؟"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       Margin="0,0,0,8"/>

                            <Border Background="{StaticResource AccentSoft}"
                                    CornerRadius="10"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="الفترة السابقة"
                                               Foreground="{StaticResource Blue}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="الأرقام المالية والجلسات تتم مقارنتها تلقائيًا بالفترة السابقة بنفس المدة."
                                               Foreground="{StaticResource Muted}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource GreenSoft}"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,9,0,0">
                                <StackPanel>
                                    <TextBlock Text="الحالة الحالية"
                                               Foreground="{StaticResource Green}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="عدد اللعب النشطة وحالة الشيفت والمخزون الحالي تظل مؤشرات حية."
                                               Foreground="{StaticResource Muted}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="إعادة ضبط"
                                Style="{StaticResource SecondaryButton}"
                                Click="ResetFilters_Click"/>
                        <Button Grid.Column="2"
                                Content="تطبيق"
                                Style="{StaticResource PrimaryButton}"
                                Click="ApplyFilters_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border VerticalAlignment="Top"
                Height="3"
                Background="{StaticResource Gold}"
                Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

    </Grid>
</UserControl>