<UserControl x:Class="GHOST.Presentation.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B0E12"/>
            <Setter Property="Foreground" Value="#F2F4F7"/>
            <Setter Property="BorderBrush" Value="#2B323C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B0E12"/>
            <Setter Property="Foreground" Value="#F2F4F7"/>
            <Setter Property="BorderBrush" Value="#2B323C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#242019"/>
            <Setter Property="Foreground" Value="#D7B56D"/>
            <Setter Property="BorderBrush" Value="#5C4928"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1.7*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#11151A" BorderBrush="#252B33" BorderThickness="1"
                CornerRadius="14" Padding="16" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="اختيار جلسة" FontSize="19" FontWeight="SemiBold" Foreground="#F2F4F7"/>
                    <TextBlock Text="اختر الجهاز الذي تريد إضافة مشروبات أو سناكس على حسابه."
                               Foreground="#8E98A5" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>

                <ComboBox x:Name="SessionBox" Grid.Row="1" Margin="0,14,0,8"
                          DisplayMemberPath="DisplayName" SelectedValuePath="SessionId"
                          SelectionChanged="SessionBox_SelectionChanged"/>

                <Border Grid.Row="2" Background="#0B0E12" BorderBrush="#252B33"
                        BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="الحساب الحالي" Foreground="#8E98A5" FontSize="11"/>
                        <TextBlock x:Name="SelectedDeviceText" Text="—" FontSize="18"
                                   FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="SelectedRuntimeText" Text="مدة اللعب: —"
                                   Foreground="#B7C0CC" Margin="0,5,0,0"/>
                        <TextBlock x:Name="SelectedGamingAmountText" Text="وقت اللعب: — ج.م"
                                   Foreground="#D7B56D" FontSize="15" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="المنتج" Foreground="#8E98A5" FontSize="11"/>
                    <TextBox x:Name="BarcodeBox" Margin="0,6,0,8"
                             ToolTip="امسح الباركود أو اكتبه ثم اضغط Enter"
                             KeyDown="BarcodeBox_KeyDown"/>
                    <Button Content="بحث وإضافة بالباركود" Click="AddByBarcode_Click"/>

                    <TextBlock x:Name="ProductLookupText" Text="يمكنك استخدام قارئ باركود USB؛ غالبًا يعمل كلوحة مفاتيح."
                               Foreground="#707A87" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#11151A" BorderBrush="#252B33" BorderThickness="1"
                CornerRadius="14" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="سلة الحساب" FontSize="19" FontWeight="SemiBold" Foreground="#F2F4F7"/>
                        <TextBlock Text="المنتجات التي ستُربط بهذا اللعب." Foreground="#8E98A5"
                                   FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="مسح السلة" Click="ClearCart_Click"/>
                </Grid>

                <DataGrid x:Name="CartGrid" Grid.Row="1" Margin="0,14,0,14"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          Background="#11151A" Foreground="#F2F4F7" BorderBrush="#252B33">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="1*"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width=".8*"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="1*"/>
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="حذف" Height="30" Padding="10,2"
                                            Click="RemoveItem_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="إجمالي المنتجات" Foreground="#8E98A5" FontSize="11"/>
                        <TextBlock x:Name="ProductsTotalText" Text="0.00 ج.م" FontSize="22"
                                   FontWeight="SemiBold" Foreground="#D7B56D"/>
                        <TextBlock x:Name="CartNoticeText" Text="لم يتم حفظ عملية البيع بعد."
                                   Foreground="#707A87" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="تحديث" Width="90" Click="Refresh_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>