<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- GHOST visual system: restrained slate surfaces + muted blue accent. -->

    <Color x:Key="GhostBgColor">#0A0D12</Color>
    <Color x:Key="GhostSurfaceColor">#10151C</Color>
    <Color x:Key="GhostSurface2Color">#151B23</Color>
    <Color x:Key="GhostSurface3Color">#1B222C</Color>
    <Color x:Key="GhostSidebarColor">#0C1016</Color>
    <Color x:Key="GhostLineColor">#26303B</Color>
    <Color x:Key="GhostLineSoftColor">#1B232D</Color>
    <Color x:Key="GhostTextColor">#E2E7ED</Color>
    <Color x:Key="GhostWhiteColor">#F7F9FB</Color>
    <Color x:Key="GhostMutedColor">#8A96A5</Color>
    <Color x:Key="GhostDimColor">#626D7B</Color>

    <Color x:Key="GhostAccentColor">#5E7FA8</Color>
    <Color x:Key="GhostAccentSoftColor">#1A2635</Color>
    <Color x:Key="GhostSuccessColor">#55A884</Color>
    <Color x:Key="GhostSuccessSoftColor">#152A22</Color>
    <Color x:Key="GhostWarningColor">#C49A58</Color>
    <Color x:Key="GhostWarningSoftColor">#2A241A</Color>
    <Color x:Key="GhostInfoColor">#6E9BD0</Color>
    <Color x:Key="GhostInfoSoftColor">#182638</Color>
    <Color x:Key="GhostDangerColor">#C96F73</Color>
    <Color x:Key="GhostDangerSoftColor">#2B1D21</Color>

    <SolidColorBrush x:Key="AppBg" Color="{StaticResource GhostBgColor}"/>
    <SolidColorBrush x:Key="SidebarBg" Color="{StaticResource GhostSidebarColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource GhostSurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource GhostSurface2Color}"/>
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource GhostSurface3Color}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource GhostLineColor}"/>
    <SolidColorBrush x:Key="LineSoft" Color="{StaticResource GhostLineSoftColor}"/>
    <SolidColorBrush x:Key="White" Color="{StaticResource GhostWhiteColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource GhostTextColor}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource GhostMutedColor}"/>
    <SolidColorBrush x:Key="Dim" Color="{StaticResource GhostDimColor}"/>
    <SolidColorBrush x:Key="Gold" Color="{StaticResource GhostAccentColor}"/>
    <SolidColorBrush x:Key="GoldSoft" Color="{StaticResource GhostAccentSoftColor}"/>
    <SolidColorBrush x:Key="Green" Color="{StaticResource GhostSuccessColor}"/>
    <SolidColorBrush x:Key="GreenSoft" Color="{StaticResource GhostSuccessSoftColor}"/>
    <SolidColorBrush x:Key="Amber" Color="{StaticResource GhostWarningColor}"/>
    <SolidColorBrush x:Key="AmberSoft" Color="{StaticResource GhostWarningSoftColor}"/>
    <SolidColorBrush x:Key="Blue" Color="{StaticResource GhostInfoColor}"/>
    <SolidColorBrush x:Key="BlueSoft" Color="{StaticResource GhostInfoSoftColor}"/>
    <SolidColorBrush x:Key="Red" Color="{StaticResource GhostDangerColor}"/>
    <SolidColorBrush x:Key="RedSoft" Color="{StaticResource GhostDangerSoftColor}"/>

    <SolidColorBrush x:Key="GhostAccentHover" Color="#7292B9"/>
    <SolidColorBrush x:Key="GhostControlHover" Color="#202934"/>
    <SolidColorBrush x:Key="GhostControlPressed" Color="#1B232D"/>
    <SolidColorBrush x:Key="GhostActiveNav" Color="#182333"/>
    <SolidColorBrush x:Key="GhostSidebarUser" Color="#131A22"/>
    <SolidColorBrush x:Key="GhostOverlay" Color="#AA000000"/>

    <!-- Backward-compatible application token aliases. -->
    <SolidColorBrush x:Key="GhostBg" Color="{StaticResource GhostBgColor}"/>
    <SolidColorBrush x:Key="GhostSurface" Color="{StaticResource GhostSurfaceColor}"/>
    <SolidColorBrush x:Key="GhostRaised" Color="{StaticResource GhostSurface3Color}"/>
    <SolidColorBrush x:Key="GhostHover" Color="{StaticResource GhostSurface2Color}"/>
    <SolidColorBrush x:Key="GhostBorder" Color="{StaticResource GhostLineColor}"/>
    <SolidColorBrush x:Key="GhostAccent" Color="{StaticResource GhostAccentColor}"/>
    <SolidColorBrush x:Key="GhostText" Color="{StaticResource GhostTextColor}"/>
    <SolidColorBrush x:Key="GhostMuted" Color="{StaticResource GhostMutedColor}"/>
    <SolidColorBrush x:Key="GhostSuccess" Color="{StaticResource GhostSuccessColor}"/>
    <SolidColorBrush x:Key="GhostWarning" Color="{StaticResource GhostWarningColor}"/>
    <SolidColorBrush x:Key="GhostDanger" Color="{StaticResource GhostDangerColor}"/>

</ResourceDictionary>