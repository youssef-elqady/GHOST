<Window x:Class="GHOST.Presentation.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="GHOST"
        Width="620"
        Height="610"
        MinWidth="560"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource GhostBg}"
        Foreground="{DynamicResource GhostText}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource GhostSurface}"
            BorderBrush="{DynamicResource GhostBorder}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Text="إضافة منتج"
                               Style="{StaticResource GhostPageTitle}"
                               FontSize="23"/>
                    <TextBlock Text="أدخل بيانات المنتج الأساسية والأسعار."
                               Style="{StaticResource GhostSecondaryText}"/>
                </StackPanel>

                <Border Width="42"
                        Height="42"
                        CornerRadius="12"
                        Background="{DynamicResource GhostAccentSoft}"
                        HorizontalAlignment="Left">
                    <materialDesign:PackIcon Kind="PackageVariantPlus"
                                             Width="22"
                                             Height="22"
                                             Foreground="{DynamicResource GhostAccent}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="اسم المنتج" Style="{StaticResource GhostCaption}" Margin="0,0,0,7"/>
                        <TextBox x:Name="NameBox"
                                 Style="{StaticResource GhostTextBox}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="التصنيف" Style="{StaticResource GhostCaption}" Margin="0,0,0,7"/>
                            <ComboBox x:Name="CategoryBox"
                                      Style="{StaticResource GhostComboBox}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الباركود" Style="{StaticResource GhostCaption}" Margin="0,0,0,7"/>
                            <TextBox x:Name="BarcodeBox"
                                     Style="{StaticResource GhostTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="سعر البيع" Style="{StaticResource GhostCaption}" Margin="0,0,0,7"/>
                            <TextBox x:Name="SellingPriceBox"
                                     Style="{StaticResource GhostTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="سعر التكلفة" Style="{StaticResource GhostCaption}" Margin="0,0,0,7"/>
                            <TextBox x:Name="CostPriceBox"
                                     Style="{StaticResource GhostTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,0,0,16">
                        <TextBlock Text="الحد الأدنى للمخزون"
                                   Style="{StaticResource GhostCaption}"
                                   Margin="0,0,0,7"/>
                        <TextBox x:Name="MinimumStockBox"
                                 Style="{StaticResource GhostTextBox}"/>
                        <TextBlock Text="سيظهر المنتج في قائمة المخزون المنخفض عند الوصول لهذا الرقم."
                                   Style="{StaticResource GhostCaption}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="4"
                            Background="{DynamicResource GhostAccentSoft}"
                            BorderBrush="{DynamicResource GhostBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <TextBlock Text="المخزون الحالي لا يتم تعديله من هنا. استخدم «حركة المخزون» لتسجيل شراء أو صرف أو تسوية."
                                   Style="{StaticResource GhostSecondaryText}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,22,0,0">
                <Button Content="إلغاء"
                        Style="{StaticResource GhostSecondaryButton}"
                        Click="Cancel_Click"
                        Margin="0,0,8,0"/>
                <Button x:Name="SaveButton"
                        Content="حفظ"
                        Style="{StaticResource GhostPrimaryButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>