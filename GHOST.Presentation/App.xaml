<Application x:Class="GHOST.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup"
             ShutdownMode="OnExplicitShutdown">

    <Application.Resources>

        <!-- ========================= -->
        <!-- GHOST COLOR SYSTEM        -->
        <!-- ========================= -->

        <Color x:Key="GhostBgColor">#0D0F14</Color>
        <Color x:Key="GhostSurfaceColor">#151922</Color>
        <Color x:Key="GhostSurfaceRaisedColor">#1D222D</Color>
        <Color x:Key="GhostSurfaceHoverColor">#252B37</Color>

        <Color x:Key="GhostBorderColor">#303746</Color>

        <Color x:Key="GhostAccentColor">#8B7CFF</Color>
        <Color x:Key="GhostAccentHoverColor">#9C90FF</Color>

        <Color x:Key="GhostTextColor">#F5F7FB</Color>
        <Color x:Key="GhostMutedColor">#98A1B2</Color>

        <Color x:Key="GhostSuccessColor">#3CCB8A</Color>
        <Color x:Key="GhostWarningColor">#E7B04B</Color>
        <Color x:Key="GhostDangerColor">#E46D78</Color>


        <!-- ========================= -->
        <!-- BRUSHES                    -->
        <!-- ========================= -->

        <SolidColorBrush x:Key="GhostBg"
                         Color="{StaticResource GhostBgColor}" />

        <SolidColorBrush x:Key="GhostSurface"
                         Color="{StaticResource GhostSurfaceColor}" />

        <SolidColorBrush x:Key="GhostRaised"
                         Color="{StaticResource GhostSurfaceRaisedColor}" />

        <SolidColorBrush x:Key="GhostHover"
                         Color="{StaticResource GhostSurfaceHoverColor}" />

        <SolidColorBrush x:Key="GhostBorder"
                         Color="{StaticResource GhostBorderColor}" />

        <SolidColorBrush x:Key="GhostAccent"
                         Color="{StaticResource GhostAccentColor}" />

        <SolidColorBrush x:Key="GhostAccentHover"
                         Color="{StaticResource GhostAccentHoverColor}" />

        <SolidColorBrush x:Key="GhostText"
                         Color="{StaticResource GhostTextColor}" />

        <SolidColorBrush x:Key="GhostMuted"
                         Color="{StaticResource GhostMutedColor}" />

        <SolidColorBrush x:Key="GhostSuccess"
                         Color="{StaticResource GhostSuccessColor}" />

        <SolidColorBrush x:Key="GhostWarning"
                         Color="{StaticResource GhostWarningColor}" />

        <SolidColorBrush x:Key="GhostDanger"
                         Color="{StaticResource GhostDangerColor}" />


        <!-- ========================= -->
        <!-- DEFAULT WINDOW             -->
        <!-- ========================= -->

        <Style TargetType="Window">

            <Setter Property="Background"
                    Value="{StaticResource GhostBg}" />

            <Setter Property="Foreground"
                    Value="{StaticResource GhostText}" />

            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="FontSize"
                    Value="14" />

        </Style>


        <!-- ========================= -->
        <!-- DEFAULT TEXTBLOCK          -->
        <!-- ========================= -->

        <Style TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource GhostText}" />

            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="FontSize"
                    Value="14" />

        </Style>


        <!-- ========================= -->
        <!-- TEXTBOX                    -->
        <!-- ========================= -->

        <Style TargetType="TextBox">

            <Setter Property="Height"
                    Value="44" />

            <Setter Property="Padding"
                    Value="14,0" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="Background"
                    Value="{StaticResource GhostSurface}" />

            <Setter Property="Foreground"
                    Value="{StaticResource GhostText}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource GhostBorder}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CaretBrush"
                    Value="{StaticResource GhostText}" />

            <Setter Property="FontSize"
                    Value="14" />

        </Style>


        <!-- ========================= -->
        <!-- PASSWORD BOX               -->
        <!-- ========================= -->

        <Style TargetType="PasswordBox">

            <Setter Property="Height"
                    Value="44" />

            <Setter Property="Padding"
                    Value="14,0" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="Background"
                    Value="{StaticResource GhostSurface}" />

            <Setter Property="Foreground"
                    Value="{StaticResource GhostText}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource GhostBorder}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CaretBrush"
                    Value="{StaticResource GhostText}" />

            <Setter Property="FontSize"
                    Value="14" />

        </Style>


        <!-- ========================= -->
        <!-- PRIMARY BUTTON             -->
        <!-- ========================= -->

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44" />

            <Setter Property="Padding"
                    Value="18,0" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="Background"
                    Value="{StaticResource GhostAccent}" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource GhostAccentHover}" />

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.82" />

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.38" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================= -->
        <!-- SECONDARY BUTTON           -->
        <!-- ========================= -->

        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Background"
                    Value="{StaticResource GhostRaised}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource GhostBorder}" />

            <Setter Property="BorderThickness"
                    Value="1" />

        </Style>


        <!-- ========================= -->
        <!-- DANGER BUTTON              -->
        <!-- ========================= -->

        <Style x:Key="DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Background"
                    Value="{StaticResource GhostDanger}" />

        </Style>


        <!-- ========================= -->
        <!-- CARD                       -->
        <!-- ========================= -->

        <Style x:Key="Card"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource GhostSurface}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource GhostBorder}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="12" />

            <Setter Property="Padding"
                    Value="20" />

        </Style>

    </Application.Resources>

</Application>