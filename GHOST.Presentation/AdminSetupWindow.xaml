<Window x:Class="GHOST.Presentation.AdminSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GHOST — الإعداد الأولي"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#0C0E12"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- ===================== COLORS ===================== -->

        <SolidColorBrush x:Key="SetupText" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="SetupMuted" Color="#969DA9"/>
        <SolidColorBrush x:Key="SetupBorder" Color="#292E38"/>
        <SolidColorBrush x:Key="SetupBorderHover" Color="#3A4150"/>
        <SolidColorBrush x:Key="SetupField" Color="#1A1E25"/>
        <SolidColorBrush x:Key="SetupAccent" Color="#9185F4"/>
        <SolidColorBrush x:Key="SetupDanger" Color="#E47777"/>
        <SolidColorBrush x:Key="SetupWarning" Color="#E7B04B"/>
        <SolidColorBrush x:Key="SetupSuccess" Color="#63B894"/>

        <LinearGradientBrush x:Key="SetupAccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A093FF" Offset="0"/>
            <GradientStop Color="#7A6CE8" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===================== TEXT BOX ===================== -->

        <Style x:Key="SetupTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource SetupText}"/>
            <Setter Property="Background" Value="{StaticResource SetupField}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SetupBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource SetupText}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource SetupAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SetupBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SetupAccent}"/>
                                <Setter TargetName="Root" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#9185F4" BlurRadius="14" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== PASSWORD BOX ===================== -->

        <Style x:Key="SetupPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource SetupText}"/>
            <Setter Property="Background" Value="{StaticResource SetupField}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SetupBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource SetupText}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource SetupAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SetupBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SetupAccent}"/>
                                <Setter TargetName="Root" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#9185F4" BlurRadius="14" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== PRIMARY BUTTON ===================== -->

        <Style x:Key="SetupPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SetupAccentGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border x:Name="Face"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect Color="#9185F4" BlurRadius="22" ShadowDepth="4" Opacity="0.32"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Overlay"
                                    Background="White"
                                    Opacity="0"
                                    CornerRadius="12"
                                    IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0"/>
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid>

        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.08" RadiusX="0.8" RadiusY="0.7">
                <GradientStop Color="#1A1828" Offset="0"/>
                <GradientStop Color="#111319" Offset="0.45"/>
                <GradientStop Color="#0C0E12" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <StackPanel Width="450" HorizontalAlignment="Center" Margin="0,40,0,40">

                <!-- ============ BRAND ============ -->

                <StackPanel HorizontalAlignment="Center">

                    <Grid Width="110" Height="110" HorizontalAlignment="Center">

                        <!-- soft glow behind the ghost -->
                        <Ellipse Width="104" Height="104" IsHitTestVisible="False" Opacity="0.5">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#557A6CE8" Offset="0"/>
                                    <GradientStop Color="#227A6CE8" Offset="0.55"/>
                                    <GradientStop Color="#007A6CE8" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- the ghost (floats gently) -->
                        <Grid x:Name="GhostMark" Width="64" Height="72"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="GhostFloat" Y="0"/>
                            </Grid.RenderTransform>

                            <Path Stretch="Uniform"
                                  Data="M40,4 C21,4 8,18 8,38 L8,72 L18,64 L29,72 L40,64 L51,72 L62,64 L72,72 L72,38 C72,18 59,4 40,4 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#C9C4EA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FlowDirection="LeftToRight"
                                        Margin="0,-6,0,0">
                                <Ellipse Width="8" Height="12" Fill="#15161C" Margin="0,0,10,0"/>
                                <Ellipse Width="8" Height="12" Fill="#15161C"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <TextBlock Text="GHOST"
                               Foreground="{StaticResource SetupText}"
                               FontSize="32" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="PLAYSTATION  •  MANAGEMENT SYSTEM"
                               Foreground="{StaticResource SetupMuted}"
                               FontSize="9" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- ============ INTRO ============ -->

                <StackPanel HorizontalAlignment="Center" Margin="0,28,0,0">
                    <TextBlock Text="الإعداد الأولي"
                               Foreground="{StaticResource SetupText}"
                               FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="أنشئ حساب المدير لبدء تشغيل GHOST"
                               Foreground="{StaticResource SetupMuted}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- ============ CARD ============ -->

                <Border Background="#15181E"
                        BorderBrush="{StaticResource SetupBorder}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="30"
                        Margin="0,24,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="35" ShadowDepth="7" Opacity="0.28" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="حساب المدير"
                                   Foreground="{StaticResource SetupText}"
                                   FontSize="19" FontWeight="SemiBold"/>

                        <TextBlock Text="هذا الحساب يملك كل الصلاحيات. احتفظ ببياناته في مكان آمن، لأن كلمة المرور لا يمكن استرجاعها بعد إنشائها."
                                   Foreground="{StaticResource SetupMuted}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,7,0,22"/>

                        <Border Height="1" Background="{StaticResource SetupBorder}" Margin="0,0,0,22"/>

                        <!-- USERNAME -->

                        <TextBlock Text="اسم المستخدم"
                                   Foreground="{StaticResource SetupText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBox x:Name="username"
                                 Style="{StaticResource SetupTextBox}"
                                 MaxLength="60"/>

                        <TextBlock x:Name="usernameHint" FontSize="11" Margin="0,6,0,0"/>

                        <!-- PASSWORD -->

                        <TextBlock Text="كلمة المرور"
                                   Foreground="{StaticResource SetupText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Margin="0,20,0,8"/>

                        <PasswordBox x:Name="password"
                                     Style="{StaticResource SetupPasswordBox}"
                                     MaxLength="128"/>

                        <!-- strength meter -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <UniformGrid Columns="4" VerticalAlignment="Center">
                                <Border x:Name="seg1" Height="4" CornerRadius="2" Background="#292E38" Margin="0,0,4,0"/>
                                <Border x:Name="seg2" Height="4" CornerRadius="2" Background="#292E38" Margin="0,0,4,0"/>
                                <Border x:Name="seg3" Height="4" CornerRadius="2" Background="#292E38" Margin="0,0,4,0"/>
                                <Border x:Name="seg4" Height="4" CornerRadius="2" Background="#292E38"/>
                            </UniformGrid>

                            <TextBlock x:Name="strengthLabel"
                                       Grid.Column="1"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="passwordHint" FontSize="11" Margin="0,6,0,0"/>

                        <!-- CONFIRM -->

                        <TextBlock Text="تأكيد كلمة المرور"
                                   Foreground="{StaticResource SetupText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Margin="0,20,0,8"/>

                        <PasswordBox x:Name="confirmation"
                                     Style="{StaticResource SetupPasswordBox}"
                                     MaxLength="128"/>

                        <TextBlock x:Name="matchHint" FontSize="11" Margin="0,6,0,0"/>

                        <TextBlock x:Name="capsWarning"
                                   Text="⚠ زر Caps Lock مفعّل"
                                   Foreground="{StaticResource SetupWarning}"
                                   FontSize="11"
                                   Margin="0,10,0,0"
                                   Visibility="Collapsed"/>

                        <!-- ERROR -->

                        <Border x:Name="errorContainer"
                                Background="#20E47777"
                                BorderBrush="{StaticResource SetupDanger}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12"
                                Margin="0,18,0,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="26" Height="26" Background="#35E47777" CornerRadius="8" VerticalAlignment="Top">
                                    <TextBlock Text="!"
                                               Foreground="{StaticResource SetupDanger}"
                                               FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock x:Name="error"
                                           Grid.Column="1"
                                           Foreground="{StaticResource SetupDanger}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           LineHeight="19"
                                           Margin="10,3,0,0"/>
                            </Grid>
                        </Border>

                        <!-- BUTTON -->

                        <Button x:Name="createButton"
                                Content="إنشاء الحساب والبدء"
                                Style="{StaticResource SetupPrimaryButton}"
                                Margin="0,24,0,0"
                                Click="CreateAdmin_Click"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SetupSuccess}" VerticalAlignment="Center"/>
                            <TextBlock Text="كلمة المرور تُحفظ مشفّرة على هذا الجهاز فقط"
                                       Foreground="{StaticResource SetupMuted}"
                                       FontSize="10"
                                       Margin="7,0,0,0"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
