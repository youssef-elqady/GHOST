<Window x:Class="GHOST.Presentation.AdminSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GHOST — الإعداد الأولي" Height="340" Width="480" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FlowDirection="RightToLeft" Background="#171923">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="إنشاء حساب المدير الأول" Foreground="White" FontSize="24" Margin="0,0,0,20"/>
        <TextBox x:Name="username" Grid.Row="1" Height="35" ToolTip="اسم المستخدم"/>
        <PasswordBox x:Name="password" Grid.Row="2" Height="35" Margin="0,12,0,0" ToolTip="كلمة المرور (12 حرفاً على الأقل)"/>
        <PasswordBox x:Name="confirmation" Grid.Row="3" Height="35" Margin="0,12,0,0" ToolTip="تأكيد كلمة المرور"/>
        <StackPanel Grid.Row="4" Margin="0,20,0,0"><TextBlock x:Name="error" Foreground="#FFB4AB" TextWrapping="Wrap"/><Button Content="إنشاء حساب المدير" Width="160" Height="38" HorizontalAlignment="Left" Margin="0,12,0,0" Click="CreateAdmin_Click"/></StackPanel>
    </Grid>
</Window>
