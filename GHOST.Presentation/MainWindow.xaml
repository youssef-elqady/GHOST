<Window x:Class="GHOST.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GHOST.Presentation.ViewModels"
        Title="GHOST"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppBg}"
        Foreground="{StaticResource White}"
        ResizeMode="CanResize"
        WindowState="Maximized"
        ShowInTaskbar="True"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ============================================================= -->
        <!-- CONTENT-ONLY TAB CONTROL                                       -->
        <!-- ============================================================= -->

        <Style x:Key="ContentOnlyTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter
                            ContentSource="SelectedContent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- GLOBAL TEXT                                                    -->
        <!-- ============================================================= -->

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource White}"/>
        </Style>

        <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- ============================================================= -->
        <!-- NAVIGATION                                                     -->
        <!-- ============================================================= -->

        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource GhostControlHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource White}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource GhostControlPressed}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" Value="Active">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource GhostActiveNav}"/>
                                <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource GhostControlHover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Line}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#20252D"/>
                                <Setter Property="Foreground" Value="{StaticResource White}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- BUTTONS                                                        -->
        <!-- ============================================================= -->

        <Style x:Key="PremiumPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PremiumSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="17,0"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#22272F"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3B434F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#1B2027"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#2A3038"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#292F38"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#46505D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- PANELS                                                         -->
        <!-- ============================================================= -->

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="KpiPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- ============================================================= -->
        <!-- STATUS BADGE                                                   -->
        <!-- ============================================================= -->

        <Style x:Key="DeviceStatusBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GreenSoft}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AmberSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReserved}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlueSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMaintenance}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RedSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                    <Setter Property="Background" Value="#25292E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Green}"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReserved}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMaintenance}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Red}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================= -->
        <!-- DEVICE CARD                                                    -->
        <!-- ============================================================= -->

        <Style x:Key="DeviceCard" TargetType="Border">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="17"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="0"
                                      Opacity="0.20"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3D4652"/>
                    <Setter Property="Background" Value="#161A20"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="BorderBrush" Value="#315343"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.91"
                                                 Duration="0:0:1.35"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="BorderBrush" Value="#5A492C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReserved}" Value="True">
                    <Setter Property="BorderBrush" Value="#354864"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMaintenance}" Value="True">
                    <Setter Property="BorderBrush" Value="#5A3538"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                    <Setter Property="Opacity" Value="0.58"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================= -->
        <!-- TAB                                                            -->
        <!-- ============================================================= -->

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot"
                                Background="Transparent"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#232830"/>
                                <Setter Property="Foreground" Value="{StaticResource White}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#1A1F25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================= -->
        <!-- SIDEBAR                                                        -->
        <!-- ============================================================= -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBg}"
                BorderBrush="#20252C"
                BorderThickness="0,0,1,0">

            <Grid Margin="15,17,15,15">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BRAND -->

                <StackPanel Grid.Row="0">

                    <Grid Margin="4,2,4,30">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="46"
                                Height="46"
                                CornerRadius="13"
                                Background="{StaticResource Gold}">

                            <Path Data="M23,6 L38,14 L38,31 L23,40 L8,31 L8,14 Z
                                       M15,18 L15,28 L31,28 L31,23 L23,23 L23,18 Z"
                                  Fill="#101216"
                                  Stretch="Uniform"
                                  Margin="9"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="GHOST"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource White}"/>

                            <TextBlock Text="PLAYSTATION OPERATIONS"
                                       FontSize="7"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Dim}"
                                       Margin="1,2,0,0"/>
                        </StackPanel>

                    </Grid>

                    <TextBlock Text="OPERATIONS"
                               Style="{StaticResource Eyebrow}"
                               Margin="7,0,7,7"/>
                    <Button x:Name="NavDashboard" Style="{StaticResource NavigationButton}" Click="Dashboard_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,11 L12,3 L21,11 L21,21 L14,21 L14,14 L10,14 L10,21 L3,21 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>
                            <TextBlock Text="الرئيسية"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavDevices" Style="{StaticResource NavigationButton}" Click="Devices_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,4 L20,4 L20,20 L4,20 Z M8,8 L16,8 L16,16 L8,16 Z"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>
                            <TextBlock Text="الأجهزة والجلسات"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavPayments" Style="{StaticResource NavigationButton}" Click="Payments_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,6 L21,6 L21,18 L3,18 Z M3,10 L21,10 M7,14 L12,14"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.7"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>
                            <TextBlock Text="المدفوعات"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavCustomers" Style="{StaticResource NavigationButton}" Click="Customers_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12
                                       M4,21 C4,16 20,16 20,21"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.7"
                                  Fill="Transparent"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>
                            <TextBlock Text="العملاء"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavInventory" Style="{StaticResource NavigationButton}" Click="Inventory_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,6 L20,6 L18,20 L6,20 Z M8,6 A4,4 0 0 1 16,6"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.7"
                                  Fill="Transparent"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>
                            <TextBlock Text="المبيعات والمخزون"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="MANAGEMENT"
                               Style="{StaticResource Eyebrow}"
                               Margin="7,25,7,7"/>

                    <Button x:Name="NavShifts" Style="{StaticResource NavigationButton}" Click="Shifts_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,3 L12,21 M4,8 L20,8 M7,3 L7,8 M17,3 L17,8"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.7"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>
                            <TextBlock Text="الشيفتات والخزينة"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavReports" Style="{StaticResource NavigationButton}" Click="Reports_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,20 L4,11 L8,11 L8,20 M10,20 L10,5 L14,5 L14,20 M16,20 L16,8 L20,8 L20,20"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.7"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>
                            <TextBlock Text="التقارير"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavAdministration" Style="{StaticResource NavigationButton}" Click="Administration_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,3 L14,7 L18,8 L15,11 L16,16 L12,14 L8,16 L9,11 L6,8 L10,7 Z"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>
                            <TextBlock Text="الإدارة"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- USER -->

                <Border Grid.Row="2"
                        Background="{StaticResource GhostSidebarUser}"
                        BorderBrush="#252B33"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="11">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUserName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource White}"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4,0,0">
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{StaticResource Green}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="  جلسة دخول نشطة"
                                           FontSize="9"
                                           Foreground="{StaticResource Dim}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Click="Logout_Click"
                                ToolTip="تسجيل الخروج">

                            <Path Data="M11,4 L11,14 M8,7 A7,7 0 1 0 16,7"
                                  Stroke="{StaticResource Muted}"
                                  StrokeThickness="1.7"
                                  Fill="Transparent"
                                  Width="17"
                                  Height="17"/>
                        </Button>

                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ============================================================= -->
        <!-- MAIN                                                           -->
        <!-- ============================================================= -->

        <Grid Grid.Column="1"
              Margin="28,24,28,24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="PageTitle"
                               Text="الرئيسية"
                               Style="{StaticResource PageTitleStyle}"/>

                    <TextBlock x:Name="PageSubtitle"
                               Text="نظرة مباشرة على حالة المكان والجلسات"
                               Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,8,0">
                        <Button Style="{StaticResource WindowControlButton}"
                                Click="WindowMinimize_Click"
                                ToolTip="تصغير">
                            <TextBlock Text="−"/>
                        </Button>

                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource WindowControlButton}"
                                Click="WindowMaximize_Click"
                                ToolTip="تكبير / استعادة">
                            <TextBlock Text="□"/>
                        </Button>

                        <Button Style="{StaticResource WindowControlButton}"
                                Click="WindowClose_Click"
                                ToolTip="إغلاق">
                            <TextBlock Text="×"/>
                        </Button>
                    </StackPanel>

                    <Border Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="12,9"
                            Margin="0,0,8,0">

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource Green}"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text="النظام يعمل"
                                       Foreground="{StaticResource Text}"
                                       FontSize="10"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PremiumSecondaryButton}"
                            Click="ThemeToggle_Click"
                            Margin="0,0,8,0"
                            ToolTip="تبديل المظهر">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 0 0 12,3 M12,7 L12,12 L16,14"
                                  Stroke="{StaticResource Text}"
                                  StrokeThickness="1.5"
                                  Fill="Transparent"
                                  Width="15"
                                  Height="15"
                                  Margin="0,0,8,0"/>
                            <TextBlock x:Name="ThemeToggleText" Text="الوضع الفاتح"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PremiumSecondaryButton}"
                            Command="{Binding RefreshCommand}">

                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19,8 A7,7 0 1 0 18,15 M19,8 L19,3 M19,8 L14,8"
                                  Stroke="{StaticResource Text}"
                                  StrokeThickness="1.6"
                                  Fill="Transparent"
                                  Width="15"
                                  Height="15"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- CONTENT NAVIGATION IS CONTROLLED BY THE SIDEBAR -->

            <!-- CONTENT -->

            <Grid Grid.Row="2">

                <TabControl x:Name="ContentTabs"
                            SelectedIndex="0"
                            Style="{StaticResource ContentOnlyTabControl}">

                    <!-- ================================================= -->
                    <!-- DASHBOARD                                           -->
                    <!-- ================================================= -->

                    <TabItem>
                        <ContentControl x:Name="DashboardHost"/>
                    </TabItem>

                    <!-- DEVICES                                             -->
                    <!-- ================================================= -->

                    <TabItem>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <TextBlock Text="DEVICES"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock Text="الأجهزة والجلسات"
                                           FontSize="25"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource White}"/>

                                <TextBlock Text="تشغيل ومتابعة أجهزة اللعب والجلسات الحالية."
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           Margin="0,5,0,17"/>

                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource LineSoft}"
                                        BorderThickness="1"
                                        CornerRadius="15"
                                        Padding="16">

                                    <ItemsControl ItemsSource="{Binding Devices}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DeviceCardViewModel}">

                                                <Border Style="{StaticResource DeviceCard}">

                                                    <StackPanel>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="19"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding Type}"
                                                                           FontSize="9"
                                                                           Foreground="{StaticResource Dim}"
                                                                           Margin="0,3,0,0"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding StatusText}"
                                                                       Foreground="{StaticResource Green}"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"/>
                                                        </Grid>

                                                        <Border Height="1"
                                                                Background="{StaticResource LineSoft}"
                                                                Margin="0,13"/>

                                                        <TextBlock Text="{Binding RoomName, StringFormat={}الغرفة  •  {0}}"
                                                                   Foreground="{StaticResource Text}"
                                                                   FontSize="10"/>

                                                        <TextBlock Text="{Binding SingleRateText, StringFormat={}Single  •  {0}}"
                                                                   Foreground="{StaticResource Muted}"
                                                                   FontSize="9"
                                                                   Margin="0,7,0,0"/>

                                                        <TextBlock Text="{Binding MultiRateText, StringFormat={}Multi  •  {0}}"
                                                                   Foreground="{StaticResource Muted}"
                                                                   FontSize="9"
                                                                   Margin="0,5,0,0"/>

                                                        <Border Background="#0F1216"
                                                                BorderBrush="{StaticResource LineSoft}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="10"
                                                                Margin="0,12,0,0">

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0"
                HorizontalAlignment="Right">
                                                                    <TextBlock Text="مدة الجلسة"
                   Foreground="{StaticResource Dim}"
                   FontSize="8"/>

                                                                    <TextBlock Text="{Binding Runtime}"
                   Foreground="{StaticResource Gold}"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,3,0,0"/>
                                                                </StackPanel>

                                                                <Border Grid.Column="1"
                                                                          Width="1"
                                                                          Height="28"
                                                                          Background="{StaticResource LineSoft}"
                                                                                      Margin="14,0"/>

                                                                <StackPanel Grid.Column="2"
                                                                     HorizontalAlignment="Left">
                                                                      <TextBlock Text="الحساب الحالي"
                                                                      Foreground="{StaticResource Dim}"
                                                                      FontSize="8"/>

                                                                       <TextBlock Text="{Binding CurrentAmount}"
                                                                      Foreground="{StaticResource White}"
                                                                      FontSize="12"
                                                                      FontWeight="SemiBold"
                                                                     Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,12,0,0">

                                                            <Button Content="بدء"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Command="{Binding DataContext.StartSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanStartSession}"/>

                                                            <Button Content="إيقاف"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Command="{Binding DataContext.PauseOrResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanPauseSession}"/>

                                                            <Button Content="استئناف"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Command="{Binding DataContext.PauseOrResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanResumeSession}"/>

                                                            <Button Content="إنهاء"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Command="{Binding DataContext.EndSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanEndSession}"/>
                                                        </StackPanel>

                                                    </StackPanel>
                                                </Border>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================================================= -->
                    <!-- PAYMENTS                                             -->
                    <!-- ================================================= -->

                    <TabItem>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="460"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Margin="20">

                                <TextBlock Text="CASH DESK"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock Text="المدفوعات"
                                           FontSize="30"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="تحصيل الجلسات وإغلاق الحسابات النقدية."
                                           Foreground="{StaticResource Muted}"
                                           FontSize="12"
                                           Margin="0,7,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource Panel}"
                                    Padding="25"
                                    VerticalAlignment="Center">

                                <StackPanel>

                                    <TextBlock Text="تحصيل جلسة"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="الحساب الحالي"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="9"
                                               Margin="0,5,0,20"/>

                                    <Border Background="#0E1115"
                                            BorderBrush="{StaticResource LineSoft}"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            Padding="16"
                                            Margin="0,0,0,20">

                                        <StackPanel>
                                            <TextBlock Text="المبلغ المستحق"
                                                       Foreground="{StaticResource Dim}"
                                                       FontSize="9"/>

                                            <TextBlock Text="{Binding AmountDue, StringFormat={}{0:N2} ج.م}"
                                                       FontSize="35"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource White}"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="المبلغ المستلم"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="9"/>

                                    <TextBox x:Name="receivedAmount"
                                             Height="48"
                                             Margin="0,7,0,13"
                                             Padding="13,0"
                                             VerticalContentAlignment="Center"
                                             FontSize="16"
                                             Background="#0D1014"
                                             Foreground="{StaticResource White}"
                                             BorderBrush="{StaticResource Line}"
                                             BorderThickness="1"/>

                                    <Button Style="{StaticResource PremiumPrimaryButton}"
                                            Command="{Binding PaySessionCommand}"
                                            CommandParameter="{Binding Text, ElementName=receivedAmount}">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="تسجيل الدفع"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{Binding PaymentNotice}"
                                               Foreground="{StaticResource Amber}"
                                               TextWrapping="Wrap"
                                               FontSize="10"
                                               Margin="0,13,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ================================================= -->
                    <!-- CUSTOMERS                                            -->
                    <!-- ================================================= -->

                    <TabItem>
                        <Grid>
                            <Border Style="{StaticResource Panel}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="700">

                                <StackPanel HorizontalAlignment="Center"
                                            Margin="30">

                                    <TextBlock Text="CUSTOMERS"
                                               Style="{StaticResource Eyebrow}"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="العملاء"
                                               FontSize="27"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="واجهة العملاء جاهزة للربط بخدمات العملاء الحالية."
                                               Foreground="{StaticResource Muted}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Margin="0,7,0,0"/>

                                    <Border Background="{StaticResource Surface2}"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,22,0,0">

                                        <TextBlock Text="الملفات • الزيارات • الإنفاق • الولاء • الهدايا"
                                                   Foreground="{StaticResource Text}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ================================================= -->
                    <!-- INVENTORY                                            -->
                    <!-- ================================================= -->

                    <TabItem>
                        <ContentControl x:Name="InventoryHost"/>
                    </TabItem><TabItem>

                        <Grid>

                            <Border Style="{StaticResource Panel}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="700">

                                <StackPanel HorizontalAlignment="Center"
                                            Margin="30">

                                    <TextBlock Text="CASH CONTROL"
                                               Style="{StaticResource Eyebrow}"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="الشيفتات والخزينة"
                                               FontSize="27"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="فتح وإغلاق الشيفت ومراجعة النقدية."
                                               Foreground="{StaticResource Muted}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </TabItem>

                    <!-- ================================================= -->
                    <!-- REPORTS                                             -->
                    <!-- ================================================= -->

                    <TabItem>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <TextBlock Text="INSIGHTS"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock Text="التقارير"
                                           FontSize="27"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="تحليل أداء المكان والإيرادات والتشغيل."
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           Margin="0,5,0,18"/>

                                <UniformGrid Columns="2">

                                    <Border Style="{StaticResource Panel}"
                                            Margin="0,0,10,0">

                                        <StackPanel>
                                            <TextBlock Text="تقارير المبيعات"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="الإيرادات والمدفوعات والمنتجات والخصومات."
                                                       Foreground="{StaticResource Muted}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Panel}">

                                        <StackPanel>
                                            <TextBlock Text="تقارير التشغيل"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="الجلسات والأجهزة والعملاء وساعات الذروة."
                                                       Foreground="{StaticResource Muted}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================================================= -->
                    <!-- ADMINISTRATION                                      -->
                    <!-- ================================================= -->

                    <TabItem>

                        <StackPanel>

                            <TextBlock Text="CONTROL"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="الإدارة"
                                       FontSize="27"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="إعدادات النظام والإدارة والصلاحيات."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       Margin="0,5,0,18"/>

                            <Border Style="{StaticResource Panel}">

                                <StackPanel>

                                    <TextBlock Text="إدارة الأجهزة والغرف"
                                               FontSize="19"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding AdministrationNotice}"
                                               Foreground="{StaticResource Amber}"
                                               TextWrapping="Wrap"
                                               FontSize="10"
                                               Margin="0,8,0,17"/>

                                    <StackPanel Orientation="Horizontal">

                                        <Button Content="إضافة جهاز"
                                                Style="{StaticResource PremiumSecondaryButton}"
                                                IsEnabled="{Binding CanManageDevices}"/>

                                        <Button Content="إضافة غرفة"
                                                Style="{StaticResource PremiumSecondaryButton}"
                                                IsEnabled="{Binding CanManageDevices}"
                                                Margin="8,0,0,0"/>

                                        <Button Content="تغيير حالة جهاز"
                                                Style="{StaticResource PremiumSecondaryButton}"
                                                IsEnabled="{Binding CanManageDevices}"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </TabItem>

                </TabControl>

                <!-- LOAD LINE -->

                <ProgressBar Height="2"
                             VerticalAlignment="Top"
                             IsIndeterminate="True"
                             Background="Transparent"
                             Foreground="{StaticResource Gold}">

                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

            </Grid>
        </Grid>
    </Grid>
</Window>
