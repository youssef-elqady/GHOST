<Window x:Class="GHOST.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GHOST.Presentation.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="GHOST"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{DynamicResource GhostBackgroundBrush}"
        Foreground="{DynamicResource GhostTextPrimaryBrush}"
        ResizeMode="CanResize"
        WindowState="Maximized"
        ShowInTaskbar="True"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ============================================================= -->
        <!-- CONTENT-ONLY TAB CONTROL                                       -->
        <!-- ============================================================= -->

        <Style x:Key="ContentOnlyTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter
                            ContentSource="SelectedContent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- GLOBAL TEXT                                                    -->
        <!-- ============================================================= -->

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource White}"/>
        </Style>

        <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- ============================================================= -->
        <!-- NAVIGATION                                                     -->
        <!-- ============================================================= -->

        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource GhostControlHover}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource White}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource GhostControlPressed}"/>
                            </Trigger>

                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                         Value="Active">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource GhostActiveNav}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource Gold}"/>
                            </DataTrigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.35"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdminOnlyNavigationButton"
               TargetType="Button"
               BasedOn="{StaticResource NavigationButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsManagement}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StaffOnlyNavigationButton"
               TargetType="Button"
               BasedOn="{StaticResource NavigationButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStaff}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource GhostControlHover}"/>
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{StaticResource Line}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.72"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#20252D"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource White}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- BUTTONS                                                        -->
        <!-- ============================================================= -->

        <Style x:Key="PremiumPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.68"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.25"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PremiumSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="17,0"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#22272F"/>
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#3B434F"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.72"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.3"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#1B2027"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#2A3038"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#292F38"/>
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#46505D"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.2"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- SESSION MODE BUTTON - BASE                                    -->
        <!-- ============================================================= -->

        <Style x:Key="SessionModeButton"
       TargetType="Button">

            <Setter Property="Height"
            Value="32"/>

            <Setter Property="MinWidth"
            Value="78"/>

            <Setter Property="Padding"
            Value="10,0"/>

            <Setter Property="Margin"
            Value="0,0,6,0"/>

            <Setter Property="Background"
            Value="#15191F"/>

            <Setter Property="Foreground"
            Value="{StaticResource Muted}"/>

            <Setter Property="BorderBrush"
            Value="{StaticResource LineSoft}"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="FontSize"
            Value="9"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="Root"
                                Property="Background"
                                Value="#22272F"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="Root"
                                Property="Opacity"
                                Value="0.75"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                             Value="False">

                                <Setter TargetName="Root"
                                Property="Opacity"
                                Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ============================================================= -->
        <!-- SINGLE BUTTON                                                  -->
        <!-- ============================================================= -->

        <Style x:Key="SessionModeSingleButton"
       TargetType="Button"
       BasedOn="{StaticResource SessionModeButton}">

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsSingleSelected}"
                     Value="True">

                    <Setter Property="Background"
                    Value="#2A2315"/>

                    <Setter Property="Foreground"
                    Value="{StaticResource Gold}"/>

                    <Setter Property="BorderBrush"
                    Value="{StaticResource Gold}"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- ============================================================= -->
        <!-- MULTI BUTTON                                                   -->
        <!-- ============================================================= -->

        <Style x:Key="SessionModeMultiButton"
       TargetType="Button"
       BasedOn="{StaticResource SessionModeButton}">

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsMultiSelected}"
                     Value="True">

                    <Setter Property="Background"
                    Value="{StaticResource BlueSoft}"/>

                    <Setter Property="Foreground"
                    Value="{StaticResource Blue}"/>

                    <Setter Property="BorderBrush"
                    Value="{StaticResource Blue}"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>
        <!-- ============================================================= -->
        <!-- PANELS                                                         -->
        <!-- ============================================================= -->

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="KpiPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- ============================================================= -->
        <!-- STATUS BADGE                                                   -->
        <!-- ============================================================= -->

        <Style x:Key="DeviceStatusBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GreenSoft}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="CornerRadius" Value="20"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource AmberSoft}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsReserved}" Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource BlueSoft}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsMaintenance}" Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource RedSoft}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                    <Setter Property="Background"
                            Value="#25292E"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceStatusText" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource Green}"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Foreground"
                            Value="{StaticResource Amber}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsReserved}" Value="True">
                    <Setter Property="Foreground"
                            Value="{StaticResource Blue}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsMaintenance}" Value="True">
                    <Setter Property="Foreground"
                            Value="{StaticResource Red}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                    <Setter Property="Foreground"
                            Value="{StaticResource Dim}"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>

        <!-- ============================================================= -->
        <!-- DEVICE CARD                                                    -->
        <!-- ============================================================= -->

        <Style x:Key="DeviceCard" TargetType="Border">
            <Setter Property="Width" Value="286"/>
            <Setter Property="MinHeight" Value="235"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="22"
                                      ShadowDepth="0"
                                      Opacity="0.18"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
                    <Setter Property="Background" Value="{StaticResource Surface2}"/>
                </Trigger>

                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="BorderBrush" Value="#315D47"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="BorderBrush" Value="#5A492C"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsReserved}" Value="True">
                    <Setter Property="BorderBrush" Value="#354864"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsMaintenance}" Value="True">
                    <Setter Property="BorderBrush" Value="#5A3538"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                    <Setter Property="Opacity" Value="0.58"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================= -->
        <!-- TAB                                                            -->
        <!-- ============================================================= -->

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground"
                    Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,3,0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">

                        <Border x:Name="TabRoot"
                                Background="Transparent"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot"
                                        Property="Background"
                                        Value="#232830"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource White}"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot"
                                        Property="Background"
                                        Value="#1A1F25"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================= -->
        <!-- PREMIUM SIDEBAR                                                -->
        <!-- ============================================================= -->

        <Border Grid.Column="0"
        Background="{DynamicResource GhostSurfaceBrush}"
        BorderBrush="{DynamicResource GhostBorderBrush}"
        BorderThickness="0,0,1,0">

            <Grid Margin="16,18,16,16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===================================================== -->
                <!-- BRAND                                                   -->
                <!-- ===================================================== -->

                <Grid Grid.Row="0"
              Margin="4,2,4,30">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48"
                    Height="48"
                    CornerRadius="14"
                    Background="{DynamicResource GhostPrimaryBrush}"
                    HorizontalAlignment="Left">

                        <TextBlock Text="G"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0B0D10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                        Margin="13,0,0,0"
                        VerticalAlignment="Center">

                        <TextBlock Text="GHOST"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource GhostTextPrimaryBrush}"/>

                        <TextBlock Text="PLAYSTATION OPERATIONS"
                           FontSize="7"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GhostTextMutedBrush}"
                           Margin="1,3,0,0"/>

                    </StackPanel>

                </Grid>

                <!-- ===================================================== -->
                <!-- NAVIGATION                                              -->
                <!-- ===================================================== -->

                <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock Text="OPERATIONS"
                           Style="{StaticResource GhostCaption}"
                           FontWeight="SemiBold"
                           Margin="7,0,7,8"/>

                        <!-- Dashboard -->

                        <Button x:Name="NavDashboard"
                        Style="{StaticResource AdminOnlyNavigationButton}"
                        Click="Dashboard_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="ViewDashboardOutline"
                                                 Width="20"
                                                 Height="20"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground,
                                                     RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Margin="0,0,13,0"/>

                                <TextBlock Text="الرئيسية"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>

                            </StackPanel>

                        </Button>

                        <!-- Devices -->

                        <Button x:Name="NavDevices"
                        Style="{StaticResource StaffOnlyNavigationButton}"
                        Click="Devices_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="GamepadVariantOutline"
                                                 Width="20"
                                                 Height="20"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground,
                                                     RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Margin="0,0,13,0"/>

                                <TextBlock Text="الأجهزة واللعب"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>

                            </StackPanel>

                        </Button>

                        <!-- Payments -->

                        <Button x:Name="NavPayments"
                        Style="{StaticResource StaffOnlyNavigationButton}"
                        Click="Payments_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="CashMultiple"
                                                 Width="20"
                                                 Height="20"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground,
                                                     RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Margin="0,0,13,0"/>

                                <TextBlock Text="المدفوعات"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>

                            </StackPanel>

                        </Button>

                        <!-- Customers -->

                        <Button x:Name="NavCustomers"
                        Style="{StaticResource StaffOnlyNavigationButton}"
                        Click="Customers_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="AccountGroupOutline"
                                                 Width="20"
                                                 Height="20"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground,
                                                     RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Margin="0,0,13,0"/>

                                <TextBlock Text="العملاء"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>

                            </StackPanel>

                        </Button>

                        <!-- Inventory -->

                        <Button x:Name="NavInventory"
                        Style="{StaticResource NavigationButton}"
                        Click="Inventory_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                 Width="20"
                                                 Height="20"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground,
                                                     RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Margin="0,0,13,0"/>

                                <TextBlock Text="{Binding InventoryNavText}"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>

                            </StackPanel>

                        </Button>

                        <!-- ================================================= -->
                        <!-- MANAGEMENT                                          -->
                        <!-- ================================================= -->

                        <TextBlock Text="MANAGEMENT"
                           Style="{StaticResource GhostCaption}"
                           FontWeight="SemiBold"
                           Margin="7,28,7,8"/>

                        <!-- Shifts -->

                        <Button x:Name="NavShifts"
                        Style="{StaticResource StaffOnlyNavigationButton}"
                        Click="Shifts_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="CashRegister"
                                                 Width="20"
                                                 Height="20"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground,
                                                     RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Margin="0,0,13,0"/>

                                <TextBlock Text="الشيفتات والخزينة"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>

                            </StackPanel>

                        </Button>

                        <!-- Reports -->

                        <Button x:Name="NavReports"
                        Style="{StaticResource AdminOnlyNavigationButton}"
                        Click="Reports_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="ChartBoxOutline"
                                                 Width="20"
                                                 Height="20"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground,
                                                     RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Margin="0,0,13,0"/>

                                <TextBlock Text="التقارير"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>

                            </StackPanel>

                        </Button>

                        <!-- Administration -->

                        <Button x:Name="NavAdministration"
                        Style="{StaticResource AdminOnlyNavigationButton}"
                        Click="Administration_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="ShieldCrownOutline"
                                                 Width="20"
                                                 Height="20"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground,
                                                     RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Margin="0,0,13,0"/>

                                <TextBlock Text="الإدارة"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </ScrollViewer>

                <!-- ===================================================== -->
                <!-- CURRENT USER                                            -->
                <!-- ===================================================== -->

                <Border Grid.Row="2"
                Background="{DynamicResource GhostSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource GhostBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12"
                Margin="0,14,0,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->

                        <Border Width="36"
                        Height="36"
                        CornerRadius="11"
                        Background="{DynamicResource GhostPrimaryBrush}"
                        VerticalAlignment="Center">

                            <TextBlock Text="{Binding CurrentUserName,
                                              StringFormat={}{0:1}}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#0B0D10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        </Border>

                        <!-- User -->

                        <StackPanel Grid.Column="1"
                            Margin="10,0,8,0"
                            VerticalAlignment="Center">

                            <TextBlock Text="{Binding CurrentUserName}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GhostTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>

                            <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">

                                <Ellipse Width="6"
                                 Height="6"
                                 Fill="{DynamicResource GhostSuccessBrush}"
                                 VerticalAlignment="Center"/>

                                <TextBlock Text="  جلسة دخول نشطة"
                                   FontSize="9"
                                   Foreground="{DynamicResource GhostTextMutedBrush}"/>

                            </StackPanel>

                        </StackPanel>

                        <!-- Logout -->

                        <Button Grid.Column="2"
                        Style="{StaticResource GhostIconButton}"
                        Width="36"
                        Height="36"
                        Click="Logout_Click"
                        ToolTip="تسجيل الخروج">

                            <materialDesign:PackIcon Kind="Logout"
                                             Width="19"
                                             Height="19"/>

                        </Button>

                    </Grid>

                </Border>

            </Grid>

        </Border>
        <!-- ============================================================= -->
        <!-- MAIN                                                           -->
        <!-- ============================================================= -->

        <Grid Grid.Column="1"
              Margin="28,24,28,24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock x:Name="PageTitle"
                               Text="الرئيسية"
                               Style="{StaticResource PageTitleStyle}"/>

                    <TextBlock x:Name="PageSubtitle"
                               Text="نظرة مباشرة على حالة المكان والجلسات"
                               Style="{StaticResource PageSubtitleStyle}"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,8,0">

                        <Button Style="{StaticResource WindowControlButton}"
                                Click="WindowMinimize_Click"
                                ToolTip="تصغير">

                            <TextBlock Text="−"/>

                        </Button>

                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource WindowControlButton}"
                                Click="WindowMaximize_Click"
                                ToolTip="تكبير / استعادة">

                            <TextBlock Text="□"/>

                        </Button>

                        <Button Style="{StaticResource WindowControlButton}"
                                Click="WindowClose_Click"
                                ToolTip="إغلاق">

                            <TextBlock Text="×"/>

                        </Button>

                    </StackPanel>

                    <Border Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="12,9"
                            Margin="0,0,8,0">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource Green}"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text="النظام يعمل"
                                       Foreground="{StaticResource Text}"
                                       FontSize="10"
                                       Margin="8,0,0,0"/>

                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PremiumSecondaryButton}"
                            Click="ThemeToggle_Click"
                            Margin="0,0,8,0"
                            ToolTip="تبديل المظهر">

                        <StackPanel Orientation="Horizontal">

                            <Path
                                Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 0 0 12,3 M12,7 L12,12 L16,14"
                                Stroke="{StaticResource Text}"
                                StrokeThickness="1.5"
                                Fill="Transparent"
                                Width="15"
                                Height="15"
                                Margin="0,0,8,0"/>

                            <TextBlock x:Name="ThemeToggleText"
                                       Text="الوضع الفاتح"/>

                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PremiumSecondaryButton}"
                            Command="{Binding RefreshCommand}">

                        <StackPanel Orientation="Horizontal">

                            <Path
                                Data="M19,8 A7,7 0 1 0 18,15 M19,8 L19,3 M19,8 L14,8"
                                Stroke="{StaticResource Text}"
                                StrokeThickness="1.6"
                                Fill="Transparent"
                                Width="15"
                                Height="15"
                                Margin="0,0,8,0"/>

                            <TextBlock Text="تحديث"/>

                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- CONTENT -->

            <Grid Grid.Row="2">

                <TabControl x:Name="ContentTabs"
                            SelectedIndex="0"
                            Style="{StaticResource ContentOnlyTabControl}">

                    <!-- ================================================= -->
                    <!-- DASHBOARD                                           -->
                    <!-- ================================================= -->

                    <TabItem>
                        <ContentControl x:Name="DashboardHost"/>
                    </TabItem>

                    <!-- ================================================= -->
                    <!-- DEVICES                                             -->
                    <!-- ================================================= -->

                    <TabItem>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <TextBlock Text="DEVICES"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock Text="الأجهزة والجلسات"
                                           FontSize="25"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="تشغيل ومتابعة أجهزة اللعب واللعب الحالي."
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           Margin="0,5,0,17"/>

                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource LineSoft}"
                                        BorderThickness="1"
                                        CornerRadius="15"
                                        Padding="16">

                                    <ItemsControl ItemsSource="{Binding Devices}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate DataType="{x:Type vm:DeviceCardViewModel}">

                                                <Border Style="{StaticResource DeviceCard}">

                                                    <StackPanel>

                                                        <!-- HEADER -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="{StaticResource White}"
                                                                           FontSize="17"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding Type}"
                                                                           Foreground="{StaticResource Muted}"
                                                                           FontSize="9"
                                                                           Margin="0,4,0,0"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Top">
                                                                <Ellipse Width="8"
                                                                         Height="8"
                                                                         Fill="{StaticResource Gold}"
                                                                         Margin="0,2,5,0"/>
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           Foreground="{StaticResource Gold}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- ROOM -->
                                                        <Border Background="{StaticResource Surface2}"
                                                                CornerRadius="8"
                                                                Padding="9,6"
                                                                Margin="0,14,0,10">
                                                            <Grid>
                                                                <TextBlock Text="{Binding RoomName}"
                                                                           Foreground="{StaticResource Text}"
                                                                           FontSize="9"/>
                                                                <TextBlock Text="{Binding AirConditioningText}"
                                                                           Foreground="{StaticResource Dim}"
                                                                           FontSize="8"
                                                                           HorizontalAlignment="Left"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- SESSION -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel>
                                                                <TextBlock Text="الجلسة الحالية"
                                                                           Foreground="{StaticResource Dim}"
                                                                           FontSize="8"/>
                                                                <TextBlock Text="{Binding ActiveSessionModeText}"
                                                                           Foreground="{StaticResource Text}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Margin="0,3,0,0"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1"
                                                                        HorizontalAlignment="Left">
                                                                <TextBlock Text="السعر"
                                                                           Foreground="{StaticResource Dim}"
                                                                           FontSize="8"
                                                                           HorizontalAlignment="Left"/>
                                                                <TextBlock Text="{Binding ActiveSessionRateText}"
                                                                           Foreground="{StaticResource Gold}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold"
                                                                           Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- LIVE TIMER + AMOUNT -->
                                                        <Border Background="{StaticResource GoldSoft}"
                                                                BorderBrush="#4B3B1D"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="12"
                                                                Margin="0,12,0,0">

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel>
                                                                    <TextBlock Text="مدة اللعب"
                                                                               Foreground="{StaticResource Muted}"
                                                                               FontSize="8"/>
                                                                    <TextBlock Text="{Binding Runtime}"
                                                                               Foreground="{StaticResource GoldBright}"
                                                                               FontSize="18"
                                                                               FontWeight="Bold"
                                                                               Margin="0,3,0,0"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1"
                                                                            HorizontalAlignment="Left">
                                                                    <TextBlock Text="الحساب الحالي"
                                                                               Foreground="{StaticResource Muted}"
                                                                               FontSize="8"
                                                                               HorizontalAlignment="Left"/>
                                                                    <TextBlock Text="{Binding CurrentAmount}"
                                                                               Foreground="{StaticResource White}"
                                                                               FontSize="12"
                                                                               FontWeight="Bold"
                                                                               Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>

                                                        <!-- ACTIONS -->
                                                        <Grid Margin="0,12,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="6"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0"
                                                                    Content="بدء الجلسة"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Command="{Binding DataContext.StartSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanStartSession}"
                                                                    Margin="0"/>

                                                            <Button Grid.Column="2"
                                                                    Content="إيقاف / استئناف"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Command="{Binding DataContext.PauseOrResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanPauseSession}"
                                                                    Margin="0"/>
                                                        </Grid>

                                                        <Grid Margin="0,7,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="6"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0"
                                                                    Content="إنهاء الجلسة"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Command="{Binding DataContext.EndSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanEndSession}"
                                                                    Margin="0"/>

                                                            <Button Grid.Column="2"
                                                                    Content="طلبات"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Click="OpenPlayOrders_Click"
                                                                    IsEnabled="{Binding HasActiveSession}"
                                                                    Margin="0"/>
                                                        </Grid>

                                                    </StackPanel>

                                                                <Border Grid.Column="1"
                                                                        Width="1"
                                                                        Height="28"
                                                                        Background="{StaticResource LineSoft}"
                                                                        Margin="14,0"/>

                                                                <StackPanel Grid.Column="2"
                                                                            HorizontalAlignment="Left">

                                                                    <TextBlock Text="الحساب الحالي"
                                                                               Foreground="{StaticResource Dim}"
                                                                               FontSize="8"/>

                                                                    <TextBlock Text="{Binding CurrentAmount}"
                                                                               Foreground="{StaticResource White}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Margin="0,3,0,0"/>

                                                                </StackPanel>

                                                            </Grid>

                                                        </Border>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,12,0,0">

                                                            <Button Content="بدء"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Command="{Binding DataContext.StartSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanStartSession}"/>

                                                            <Button Content="إيقاف"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Command="{Binding DataContext.PauseOrResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanPauseSession}"/>

                                                            <Button Content="استئناف"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Command="{Binding DataContext.PauseOrResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanResumeSession}"/>

                                                            <Button Content="إنهاء"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Command="{Binding DataContext.EndSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanEndSession}"/>

                                                            <Button Content="طلبات"
                                                                    Style="{StaticResource DeviceActionButton}"
                                                                    Click="OpenPlayOrders_Click"
                                                                    IsEnabled="{Binding HasActiveSession}"/>

                                                        </StackPanel>

                                                    </StackPanel>

                                                </Border>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </Border>

                            </StackPanel>

                        </ScrollViewer>

                    </TabItem>

                    <!-- ================================================= -->
                    <!-- PAYMENTS                                            -->
                    <!-- ================================================= -->

                    <TabItem>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="460"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Margin="20">

                                <TextBlock Text="CASH DESK"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock Text="المدفوعات"
                                           FontSize="30"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="تحصيل الجلسات وإغلاق الحسابات النقدية."
                                           Foreground="{StaticResource Muted}"
                                           FontSize="12"
                                           Margin="0,7,0,0"/>

                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource Panel}"
                                    Padding="25"
                                    VerticalAlignment="Center">

                                <StackPanel>

                                    <TextBlock Text="تحصيل جلسة"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="الحساب الحالي"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="9"
                                               Margin="0,5,0,20"/>

                                    <Border Background="#0E1115"
                                            BorderBrush="{StaticResource LineSoft}"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            Padding="16"
                                            Margin="0,0,0,20">

                                        <StackPanel>

                                            <TextBlock Text="المبلغ المستحق"
                                                       Foreground="{StaticResource Dim}"
                                                       FontSize="9"/>

                                            <TextBlock
                                                Text="{Binding AmountDue, StringFormat={}{0:N2} ج.م}"
                                                FontSize="35"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource White}"
                                                Margin="0,6,0,0"/>

                                        </StackPanel>

                                    </Border>

                                    <TextBlock Text="المبلغ المستلم"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="9"/>

                                    <TextBox x:Name="receivedAmount"
                                             Height="48"
                                             Margin="0,7,0,13"
                                             Padding="13,0"
                                             VerticalContentAlignment="Center"
                                             FontSize="16"
                                             Background="#0D1014"
                                             Foreground="{StaticResource White}"
                                             BorderBrush="{StaticResource Line}"
                                             BorderThickness="1"/>

                                    <Button Style="{StaticResource PremiumPrimaryButton}"
                                            Command="{Binding PaySessionCommand}"
                                            CommandParameter="{Binding Text, ElementName=receivedAmount}">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="تسجيل الدفع"/>
                                        </StackPanel>

                                    </Button>

                                    <TextBlock Text="{Binding PaymentNotice}"
                                               Foreground="{StaticResource Amber}"
                                               TextWrapping="Wrap"
                                               FontSize="10"
                                               Margin="0,13,0,0"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </TabItem>

                    <!-- ================================================= -->
                    <!-- CUSTOMERS                                           -->
                    <!-- ================================================= -->

                    <TabItem>

                        <Grid>

                            <Border Style="{StaticResource Panel}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="700">

                                <StackPanel HorizontalAlignment="Center"
                                            Margin="30">

                                    <TextBlock Text="CUSTOMERS"
                                               Style="{StaticResource Eyebrow}"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="العملاء"
                                               FontSize="27"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="واجهة العملاء جاهزة للربط بخدمات العملاء الحالية."
                                               Foreground="{StaticResource Muted}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Margin="0,7,0,0"/>

                                    <Border Background="{StaticResource Surface2}"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,22,0,0">

                                        <TextBlock
                                            Text="الملفات • الزيارات • الإنفاق • الولاء • الهدايا"
                                            Foreground="{StaticResource Text}"
                                            FontSize="10"
                                            HorizontalAlignment="Center"/>

                                    </Border>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </TabItem>

                    <!-- ================================================= -->
                    <!-- INVENTORY                                           -->
                    <!-- ================================================= -->

                    <TabItem>
                        <ContentControl x:Name="InventoryHost"/>
                    </TabItem>

                    <!-- ================================================= -->
                    <!-- SHIFTS                                              -->
                    <!-- ================================================= -->

                    <TabItem>
                        <ContentControl x:Name="ShiftHost"/>
                    </TabItem>

                    <!-- ================================================= -->
                    <!-- REPORTS                                             -->
                    <!-- ================================================= -->

                    <TabItem>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <TextBlock Text="INSIGHTS"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock Text="التقارير"
                                           FontSize="27"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="تحليل أداء المكان والإيرادات والتشغيل."
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           Margin="0,5,0,18"/>

                                <UniformGrid Columns="2">

                                    <Border Style="{StaticResource Panel}"
                                            Margin="0,0,10,0">

                                        <StackPanel>

                                            <TextBlock Text="تقارير المبيعات"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock
                                                Text="الإيرادات والمدفوعات والمنتجات والخصومات."
                                                Foreground="{StaticResource Muted}"
                                                FontSize="10"
                                                TextWrapping="Wrap"
                                                Margin="0,8,0,0"/>

                                        </StackPanel>

                                    </Border>

                                    <Border Style="{StaticResource Panel}">

                                        <StackPanel>

                                            <TextBlock Text="تقارير التشغيل"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock
                                                Text="الجلسات والأجهزة والعملاء وساعات الذروة."
                                                Foreground="{StaticResource Muted}"
                                                FontSize="10"
                                                TextWrapping="Wrap"
                                                Margin="0,8,0,0"/>

                                        </StackPanel>

                                    </Border>

                                </UniformGrid>

                            </StackPanel>

                        </ScrollViewer>

                    </TabItem>

                    <!-- ================================================= -->
                    <!-- ADMINISTRATION                                      -->
                    <!-- ================================================= -->

                    <TabItem>

                        <StackPanel>

                            <TextBlock Text="CONTROL"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="الإدارة"
                                       FontSize="27"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="إعدادات النظام والإدارة والصلاحيات."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       Margin="0,5,0,18"/>

                            <Border Style="{StaticResource Panel}">

                                <StackPanel>

                                    <TextBlock Text="إدارة الأجهزة والغرف"
                                               FontSize="19"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding AdministrationNotice}"
                                               Foreground="{StaticResource Amber}"
                                               TextWrapping="Wrap"
                                               FontSize="10"
                                               Margin="0,8,0,17"/>

                                    <StackPanel Orientation="Horizontal">

                                        <Button Content="إضافة جهاز"
                                                Style="{StaticResource PremiumSecondaryButton}"
                                                IsEnabled="{Binding CanManageDevices}"/>

                                        <Button Content="إضافة غرفة"
                                                Style="{StaticResource PremiumSecondaryButton}"
                                                IsEnabled="{Binding CanManageDevices}"
                                                Margin="8,0,0,0"/>

                                        <Button Content="تغيير حالة جهاز"
                                                Style="{StaticResource PremiumSecondaryButton}"
                                                IsEnabled="{Binding CanManageDevices}"
                                                Margin="8,0,0,0"/>

                                    </StackPanel>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </TabItem>

                </TabControl>

                <!-- LOAD LINE -->

                <ProgressBar Height="2"
                             VerticalAlignment="Top"
                             IsIndeterminate="True"
                             Background="Transparent"
                             Foreground="{StaticResource Gold}">

                    <ProgressBar.Style>

                        <Style TargetType="ProgressBar">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsLoading}"
                                             Value="True">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </DataTrigger>

