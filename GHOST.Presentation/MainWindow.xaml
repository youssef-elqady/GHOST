<Window x:Class="GHOST.Presentation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:GHOST.Presentation.ViewModels" Title="GHOST" Height="760" Width="1240" MinHeight="600" MinWidth="900" FlowDirection="RightToLeft" Background="#171923" Loaded="Window_Loaded">
    <Window.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F7F7F7" /></Style><Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#4F46E5"/><Setter Property="Foreground" Value="White"/></Style></Window.Resources>
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><StackPanel DockPanel.Dock="Right"><TextBlock Text="GHOST" FontSize="30" FontWeight="Bold"/><TextBlock Text="لوحة الأجهزة" Foreground="#B7B9C8" FontSize="16"/></StackPanel><Button DockPanel.Dock="Left" Command="{Binding RefreshCommand}" Content="تحديث"/></DockPanel>
        <TabControl Grid.Row="1" Margin="0,24,0,0" Background="#202331">
            <TabItem Header="الأجهزة"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding LoadError}" Foreground="#FFB4AB"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:DeviceCardViewModel}"><Border Width="270" Margin="8" Padding="16" Background="#2A2E3F" CornerRadius="8"><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/><TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Foreground="#B9B5FF"/></DockPanel><TextBlock Text="{Binding Type}" Foreground="#B7B9C8"/><Separator Margin="0,10"/><TextBlock Text="{Binding RoomName, StringFormat=الغرفة: {0}}"/><TextBlock Text="{Binding CurrentPrice, StringFormat=السعر: {0}}"/><TextBlock Text="{Binding ActiveSession, StringFormat=الجلسة: {0}}"/><TextBlock Text="{Binding Runtime, StringFormat=المدة: {0}}"/><TextBlock Text="{Binding CurrentAmount, StringFormat=المبلغ: {0}}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="بدء جلسة" IsEnabled="False" ToolTip="يتطلب محرك الجلسات في المرحلة الثالثة"/><Button Content="إنهاء" IsEnabled="False" ToolTip="يتطلب محرك الجلسات في المرحلة الثالثة"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></TabItem>
            <TabItem Header="الغرف"><ListView Margin="16" ItemsSource="{Binding Rooms}"><ListView.View><GridView><GridViewColumn Header="الغرفة" DisplayMemberBinding="{Binding Name}" Width="240"/><GridViewColumn Header="عدد الأجهزة" DisplayMemberBinding="{Binding DeviceCount}" Width="130"/></GridView></ListView.View></ListView></TabItem>
            <TabItem Header="إدارة الأجهزة"><StackPanel Margin="24"><TextBlock Text="إدارة الأجهزة والغرف" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding AdministrationNotice}" Margin="0,16,0,0" Foreground="#FFCC80" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="إضافة جهاز" IsEnabled="{Binding CanManageDevices}"/><Button Content="إضافة غرفة" IsEnabled="{Binding CanManageDevices}"/><Button Content="تغيير حالة جهاز" IsEnabled="{Binding CanManageDevices}"/></StackPanel></StackPanel></TabItem>
        </TabControl>
    </Grid>
</Window>
