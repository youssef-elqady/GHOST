<Window x:Class="GHOST.Presentation.StockMovementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="GHOST"
        Width="620"
        Height="590"
        MinWidth="560"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource GhostBg}"
        Foreground="{DynamicResource GhostText}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource GhostSurface}"
            BorderBrush="{DynamicResource GhostBorder}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="حركة المخزون"
                               Style="{StaticResource GhostPageTitle}"
                               FontSize="23"/>
                    <TextBlock Text="سجّل دخول أو خروج كمية من المخزون مع سبب واضح للحركة."
                               Style="{StaticResource GhostSecondaryText}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border Width="42"
                        Height="42"
                        CornerRadius="12"
                        Background="{DynamicResource GhostAccentSoft}"
                        HorizontalAlignment="Left">
                    <materialDesign:PackIcon Kind="SwapVertical"
                                             Width="22"
                                             Height="22"
                                             Foreground="{DynamicResource GhostAccent}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="المنتج" Style="{StaticResource GhostCaption}" Margin="0,0,0,7"/>
                    <ComboBox x:Name="ProductBox"
                              Style="{StaticResource GhostComboBox}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectionChanged="ProductBox_SelectionChanged"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="نوع الحركة" Style="{StaticResource GhostCaption}" Margin="0,0,0,7"/>
                        <ComboBox x:Name="TypeBox"
                                  Style="{StaticResource GhostComboBox}"
                                  SelectionChanged="TypeBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="الكمية" Style="{StaticResource GhostCaption}" Margin="0,0,0,7"/>
                        <TextBox x:Name="QuantityBox"
                                 Style="{StaticResource GhostTextBox}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Background="{DynamicResource GhostSurface2}"
                        BorderBrush="{DynamicResource GhostBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="المخزون الحالي" Style="{StaticResource GhostCaption}"/>
                            <TextBlock x:Name="CurrentStockText"
                                       Text="—"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="التأثير" Style="{StaticResource GhostCaption}"/>
                            <TextBlock x:Name="ImpactText"
                                       Text="—"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="بعد الحركة" Style="{StaticResource GhostCaption}"/>
                            <TextBlock x:Name="AfterStockText"
                                       Text="—"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Margin="0,0,0,16">
                    <TextBlock Text="سبب الحركة" Style="{StaticResource GhostCaption}" Margin="0,0,0,7"/>
                    <TextBox x:Name="ReasonBox"
                             Style="{StaticResource GhostTextBox}"
                             MinHeight="82"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="السبب جزء من السجل التاريخي ولا يمكن حذفه بعد التسجيل."
                               Style="{StaticResource GhostCaption}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="4"
                        Background="{DynamicResource GhostAccentSoft}"
                        BorderBrush="{DynamicResource GhostBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,0,0,4">
                    <TextBlock x:Name="PermissionNoteText"
                               Style="{StaticResource GhostSecondaryText}"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Grid.Row="5"
                           x:Name="ErrorText"
                           Foreground="{DynamicResource Red}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,20,0,0">
                <Button Content="إلغاء"
                        Style="{StaticResource GhostSecondaryButton}"
                        Click="Cancel_Click"
                        Margin="0,0,8,0"/>
                <Button Content="تسجيل الحركة"
                        Style="{StaticResource GhostPrimaryButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>