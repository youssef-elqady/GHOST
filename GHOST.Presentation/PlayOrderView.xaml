<Window x:Class="GHOST.Presentation.PlayOrderView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل اللعب"
        Width="980"
        Height="700"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#0B0D10"
        Foreground="#F4F4F4"
        ResizeMode="CanResize">

    <Window.Resources>

        <Style x:Key="ActionButton"
               TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#171B21"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#2B313A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ProductButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Height" Value="72"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Background" Value="#12161B"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="PLAY DETAILS"
                           Foreground="#A9AEB7"
                           FontSize="9"
                           FontWeight="SemiBold"/>

                <TextBlock Text="تفاصيل اللعب"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,7,0,0">
                    <TextBlock Text="{Binding DeviceName}"
                               Foreground="#F4C76A"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="  •  "
                               Foreground="#6F7680"
                               FontSize="11"/>

                    <TextBlock Text="{Binding RoomName}"
                               Foreground="#A9AEB7"
                               FontSize="11"/>

                    <TextBlock Text="  •  "
                               Foreground="#6F7680"
                               FontSize="11"/>

                    <TextBlock Text="{Binding ModeText}"
                               Foreground="#8AB4F8"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="إغلاق"
                    Style="{StaticResource ActionButton}"
                    Click="Close_Click"
                    Margin="12,0,0,0"/>
        </Grid>

        <!-- LIVE SUMMARY -->
        <Border Grid.Row="1"
                Background="#11151A"
                BorderBrush="#292F38"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                Margin="0,18,0,18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="مدة اللعب"
                               Foreground="#858C96"
                               FontSize="9"/>
                    <TextBlock Text="{Binding RuntimeText}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Background="#292F38"
                        Margin="16,0"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="قيمة اللعب"
                               Foreground="#858C96"
                               FontSize="9"/>
                    <TextBlock Text="{Binding PlayAmountText}"
                               Foreground="#F4C76A"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Column="3"
                        Width="1"
                        Background="#292F38"
                        Margin="16,0"/>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="الإجمالي الحالي"
                               Foreground="#858C96"
                               FontSize="9"/>
                    <TextBlock Text="{Binding TotalAmountText}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- CURRENT ORDER -->
            <Border Grid.Column="0"
                    Background="#101318"
                    BorderBrush="#292F38"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="الطلبات الحالية"
                               FontSize="17"
                               FontWeight="SemiBold"/>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,14,0,14"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OrderItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#15191F"
                                            BorderBrush="#272D35"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding ProductName}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>

                                                <TextBlock
                                                    Text="{Binding Quantity, StringFormat={}الكمية: {0}}"
                                                    Foreground="#858C96"
                                                    FontSize="9"
                                                    Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Total, StringFormat={}{0:N2} ج.م}"
                                                       Foreground="#F4C76A"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <Border Height="1"
                                Background="#292F38"
                                Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="المنتجات"
                                       Foreground="#A9AEB7"
                                       FontSize="10"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProductsAmountText}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PRODUCTS -->
            <Border Grid.Column="2"
                    Background="#101318"
                    BorderBrush="#292F38"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="إضافة منتجات"
                               FontSize="17"
                               FontWeight="SemiBold"/>

                    <ComboBox Grid.Row="1"
                              ItemsSource="{Binding Categories}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedCategoryId}"
                              Margin="0,12,0,12"
                              Height="38"
                              Background="#171B21"
                              Foreground="#E6E6E6"
                              BorderBrush="#2B313A"/>

                    <Grid Grid.Row="2">
                        <TextBlock Text="لا توجد منتجات متاحة حاليًا"
                                   Foreground="#8E98A5"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProducts}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding VisibleProducts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ProductButton}"
                                                Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding SellingPrice, StringFormat={}{0:N2} ج.م}"
                                                           Foreground="#F4C76A"
                                                           FontSize="10"
                                                           Margin="0,5,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
        </Grid>

        <!-- NOTICE -->
        <Border Grid.Row="3"
                Background="#17130A"
                BorderBrush="#4A3817"
                BorderThickness="1"
                CornerRadius="9"
                Padding="10"
                Margin="0,16,0,0">

            <TextBlock Text="{Binding Notice}"
                       Foreground="#F4C76A"
                       FontSize="10"
                       TextWrapping="Wrap"/>
        </Border>

    </Grid>
</Window>
