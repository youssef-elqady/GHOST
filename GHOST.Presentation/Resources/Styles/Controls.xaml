<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- GHOST PRIMARY BUTTON                                      -->
    <!-- ========================================================= -->

    <Style x:Key="GhostPrimaryButton"
           TargetType="Button">

        <Setter Property="Height"
                Value="46" />

        <Setter Property="MinWidth"
                Value="120" />

        <Setter Property="Padding"
                Value="20,0" />

        <Setter Property="Background"
                Value="{DynamicResource GhostPrimaryBrush}" />

        <Setter Property="Foreground"
                Value="#0B0D10" />

        <Setter Property="BorderThickness"
                Value="0" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="FontWeight"
                Value="SemiBold" />

        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource GhostPrimaryHoverBrush}" />

                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.82" />

                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.38" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- ========================================================= -->
    <!-- GHOST SECONDARY BUTTON                                    -->
    <!-- ========================================================= -->

    <Style x:Key="GhostSecondaryButton"
           TargetType="Button">

        <Setter Property="Height"
                Value="46" />

        <Setter Property="MinWidth"
                Value="120" />

        <Setter Property="Padding"
                Value="20,0" />

        <Setter Property="Background"
                Value="{DynamicResource GhostSurfaceElevatedBrush}" />

        <Setter Property="Foreground"
                Value="{DynamicResource GhostTextPrimaryBrush}" />

        <Setter Property="BorderBrush"
                Value="{DynamicResource GhostBorderBrush}" />

        <Setter Property="BorderThickness"
                Value="1" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="FontWeight"
                Value="SemiBold" />

        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource GhostSurfaceHoverBrush}" />

                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GhostBorderStrongBrush}" />

                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.82" />

                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.38" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- ========================================================= -->
    <!-- GHOST DANGER BUTTON                                       -->
    <!-- ========================================================= -->

    <Style x:Key="GhostDangerButton"
           TargetType="Button"
           BasedOn="{StaticResource GhostPrimaryButton}">

        <Setter Property="Background"
                Value="{DynamicResource GhostDangerBrush}" />

        <Setter Property="Foreground"
                Value="White" />

    </Style>


    <!-- ========================================================= -->
    <!-- GHOST ICON BUTTON                                         -->
    <!-- ========================================================= -->

    <Style x:Key="GhostIconButton"
           TargetType="Button">

        <Setter Property="Width"
                Value="42" />

        <Setter Property="Height"
                Value="42" />

        <Setter Property="Padding"
                Value="0" />

        <Setter Property="Background"
                Value="Transparent" />

        <Setter Property="Foreground"
                Value="{DynamicResource GhostTextSecondaryBrush}" />

        <Setter Property="BorderThickness"
                Value="0" />

        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource GhostSurfaceHoverBrush}" />

                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.7" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- ========================================================= -->
    <!-- GHOST TEXT BOX                                            -->
    <!-- ========================================================= -->

    <Style x:Key="GhostTextBox"
           TargetType="TextBox">

        <Setter Property="Height"
                Value="46" />

        <Setter Property="Padding"
                Value="14,0" />

        <Setter Property="VerticalContentAlignment"
                Value="Center" />

        <Setter Property="Background"
                Value="{DynamicResource GhostSurfaceBrush}" />

        <Setter Property="Foreground"
                Value="{DynamicResource GhostTextPrimaryBrush}" />

        <Setter Property="BorderBrush"
                Value="{DynamicResource GhostBorderBrush}" />

        <Setter Property="BorderThickness"
                Value="1" />

        <Setter Property="CaretBrush"
                Value="{DynamicResource GhostPrimaryBrush}" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="TextBox">

                    <Border x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">

                            <Setter TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GhostPrimaryBrush}" />

                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="TextBoxBorder"
                                    Property="Opacity"
                                    Value="0.45" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- ========================================================= -->
    <!-- GHOST CARD                                                -->
    <!-- ========================================================= -->

    <Style x:Key="GhostCard"
           TargetType="Border">

        <Setter Property="Background"
                Value="{DynamicResource GhostSurfaceBrush}" />

        <Setter Property="BorderBrush"
                Value="{DynamicResource GhostBorderBrush}" />

        <Setter Property="BorderThickness"
                Value="1" />

        <Setter Property="CornerRadius"
                Value="14" />

        <Setter Property="Padding"
                Value="20" />

    </Style>


    <!-- ========================================================= -->
    <!-- GHOST KPI CARD                                            -->
    <!-- ========================================================= -->

    <Style x:Key="GhostKpiCard"
           TargetType="Border"
           BasedOn="{StaticResource GhostCard}">

        <Setter Property="MinHeight"
                Value="120" />

        <Setter Property="Padding"
                Value="20" />

    </Style>


    <!-- ========================================================= -->
    <!-- GHOST STATUS BADGES                                       -->
    <!-- ========================================================= -->

    <Style x:Key="GhostStatusBadge"
           TargetType="Border">

        <Setter Property="CornerRadius"
                Value="20" />

        <Setter Property="Padding"
                Value="12,6" />

        <Setter Property="Background"
                Value="{DynamicResource GhostSurfaceElevatedBrush}" />

        <Setter Property="BorderBrush"
                Value="{DynamicResource GhostBorderBrush}" />

        <Setter Property="BorderThickness"
                Value="1" />

    </Style>


    <!-- ========================================================= -->
    <!-- GHOST PAGE TITLE                                          -->
    <!-- ========================================================= -->

    <Style x:Key="GhostPageTitle"
           TargetType="TextBlock">

        <Setter Property="Foreground"
                Value="{DynamicResource GhostTextPrimaryBrush}" />

        <Setter Property="FontSize"
                Value="28" />

        <Setter Property="FontWeight"
                Value="SemiBold" />

        <Setter Property="Margin"
                Value="0,0,0,6" />

    </Style>


    <!-- ========================================================= -->
    <!-- GHOST SECTION TITLE                                       -->
    <!-- ========================================================= -->

    <Style x:Key="GhostSectionTitle"
           TargetType="TextBlock">

        <Setter Property="Foreground"
                Value="{DynamicResource GhostTextPrimaryBrush}" />

        <Setter Property="FontSize"
                Value="18" />

        <Setter Property="FontWeight"
                Value="SemiBold" />

    </Style>


    <!-- ========================================================= -->
    <!-- GHOST SECONDARY TEXT                                      -->
    <!-- ========================================================= -->

    <Style x:Key="GhostSecondaryText"
           TargetType="TextBlock">

        <Setter Property="Foreground"
                Value="{DynamicResource GhostTextSecondaryBrush}" />

        <Setter Property="FontSize"
                Value="13" />

    </Style>


    <!-- ========================================================= -->
    <!-- GHOST CAPTION                                             -->
    <!-- ========================================================= -->

    <Style x:Key="GhostCaption"
           TargetType="TextBlock">

        <Setter Property="Foreground"
                Value="{DynamicResource GhostTextMutedBrush}" />

        <Setter Property="FontSize"
                Value="12" />

    </Style>

</ResourceDictionary>