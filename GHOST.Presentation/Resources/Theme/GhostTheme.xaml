<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ========================================================= -->
    <!-- GHOST DESIGN TOKENS                                       -->
    <!-- ========================================================= -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="GhostBackgroundBrush"
                     Color="#0B0D10" />

    <SolidColorBrush x:Key="GhostSurfaceBrush"
                     Color="#11151A" />

    <SolidColorBrush x:Key="GhostSurfaceElevatedBrush"
                     Color="#171C22" />

    <SolidColorBrush x:Key="GhostSurfaceHoverBrush"
                     Color="#1D242C" />

    <!-- Borders -->
    <SolidColorBrush x:Key="GhostBorderBrush"
                     Color="#28313A" />

    <SolidColorBrush x:Key="GhostBorderStrongBrush"
                     Color="#35414D" />

    <!-- Brand -->
    <SolidColorBrush x:Key="GhostPrimaryBrush"
                     Color="#D6A84F" />

    <SolidColorBrush x:Key="GhostPrimaryHoverBrush"
                     Color="#E4BC68" />

    <SolidColorBrush x:Key="GhostPrimaryPressedBrush"
                     Color="#B88A35" />

    <!-- Text -->
    <SolidColorBrush x:Key="GhostTextPrimaryBrush"
                     Color="#F5F7FA" />

    <SolidColorBrush x:Key="GhostTextSecondaryBrush"
                     Color="#A9B1BB" />

    <SolidColorBrush x:Key="GhostTextMutedBrush"
                     Color="#737D88" />

    <!-- Status -->
    <SolidColorBrush x:Key="GhostSuccessBrush"
                     Color="#4ADE80" />

    <SolidColorBrush x:Key="GhostWarningBrush"
                     Color="#F5B942" />

    <SolidColorBrush x:Key="GhostDangerBrush"
                     Color="#F87171" />

    <SolidColorBrush x:Key="GhostInfoBrush"
                     Color="#60A5FA" />

    <!-- Overlay -->
    <SolidColorBrush x:Key="GhostOverlayBrush"
                     Color="#99000000" />


    
</ResourceDictionary>